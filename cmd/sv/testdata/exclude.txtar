# Setup a git repo with a root module and two submodules
exec git init
exec git config user.email test@example.com
exec git config user.name "Test User"

cp root_go_mod go.mod
mkdir exp
mkdir exp/slidesdeck
mkdir exp/roubaix
cp sd_go_mod exp/slidesdeck/go.mod
cp rb_go_mod exp/roubaix/go.mod

exec git add go.mod exp/slidesdeck/go.mod exp/roubaix/go.mod
exec git commit -m initial
exec git tag exp/slidesdeck/v1.0.0
exec git tag exp/roubaix/v1.0.0

# Add a feature to both submodules
cp readme_sd exp/slidesdeck/readme.md
cp readme_rb exp/roubaix/readme.md
exec git add exp/slidesdeck/readme.md exp/roubaix/readme.md
exec git commit -m feat:addfeatures

# All modules are included by default
exec sv next --all
stdout 'exp/slidesdeck/v1.1.0'
stdout 'exp/roubaix/v1.1.0'

# Repeated --exclude flags omit the matching module
exec sv next --all --exclude exp/roubaix
stdout 'exp/slidesdeck/v1.1.0'
! stdout 'exp/roubaix'

# Comma-separated --exclude also works
exec sv next --all --exclude exp/slidesdeck,exp/roubaix
! stdout 'exp/slidesdeck'
! stdout 'exp/roubaix'

# --exclude combines with --path
exec sv next --path exp/roubaix --path exp/slidesdeck --exclude exp/roubaix
stdout 'exp/slidesdeck/v1.1.0'
! stdout 'exp/roubaix'

-- root_go_mod --
module github.com/qjcg/arcadia
-- sd_go_mod --
module github.com/qjcg/arcadia/exp/slidesdeck
-- rb_go_mod --
module github.com/qjcg/arcadia/exp/roubaix
-- readme_sd --
slidesdeck feature
-- readme_rb --
roubaix feature