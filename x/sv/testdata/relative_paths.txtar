# Setup git repo
exec git init
exec git config user.email test@example.com
exec git config user.name "Test User"

mkdir x
mkdir x/sv
mkdir x/slidesdeck

cp go_mod_sv x/sv/go.mod
cp go_mod_sd x/slidesdeck/go.mod

exec git add .
exec git commit -m initial
exec git tag x/slidesdeck/v1.0.0

# Add a feature
cp feat_txt x/slidesdeck/feat.txt
exec git add x/slidesdeck/feat.txt
exec git commit -m feat:relpath

# Run from x/sv pointing to ../slidesdeck
cd x/sv
exec sv next --path ../slidesdeck
stdout '^x/slidesdeck/v1.1.0'

-- go_mod_sv --
module github.com/qjcg/arcadia/x/sv
-- go_mod_sd --
module github.com/qjcg/arcadia/x/slidesdeck
-- feat_txt --
feature
