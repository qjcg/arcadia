# Setup a git repo with a submodule
exec git init
exec git config user.email test@example.com
exec git config user.name "Test User"

# Create root module
cp root_go_mod go.mod

# Create submodule
mkdir x
mkdir x/slidesdeck
cp sub_go_mod x/slidesdeck/go.mod

exec git add go.mod x/slidesdeck/go.mod
exec git commit -m initial
exec git tag v1.0.0
exec git tag x/slidesdeck/v1.0.0

# Add a feature in the submodule
cp readme x/slidesdeck/readme.md
exec git add x/slidesdeck/readme.md
exec git commit -m feat:addfeature

# Run sv inside the submodule
cd x/slidesdeck
exec sv next
stdout 'x/slidesdeck -> x/slidesdeck/v1.1.0'

# Run from root with path
cd ../..
exec sv next -p x/slidesdeck
stdout '^x/slidesdeck -> x/slidesdeck/v1.1.0'

# Root module change
exec git commit --allow-empty -m feat:root
exec sv next
stdout '^\. -> v1.1.0'

-- root_go_mod --
module github.com/qjcg/arcadia
-- sub_go_mod --
module github.com/qjcg/arcadia/x/slidesdeck
-- readme --
new feature
