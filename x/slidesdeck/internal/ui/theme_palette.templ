package ui

templ ThemePalette() {
	<div
		class="absolute inset-0 bg-base-100/60 backdrop-blur-xl flex items-start justify-center pt-24 z-[90]"
		x-show="showThemePalette"
		@keydown.escape.window="showThemePalette = false; document.documentElement.setAttribute('data-theme', originalTheme); currentTheme = originalTheme; themeQuery = '';"
		@click.self="showThemePalette = false; document.documentElement.setAttribute('data-theme', originalTheme); currentTheme = originalTheme; themeQuery = '';"
		x-cloak
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-4"
	>
		<div class="bg-base-100 rounded-[2.5rem] shadow-3xl w-full max-w-xl overflow-hidden border border-white/5 flex flex-col max-h-[70vh]">
			<div class="relative p-2">
				<div class="absolute inset-y-0 left-8 flex items-center pointer-events-none opacity-40">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
				</div>
				<input
					type="text"
					class="w-full bg-base-200/50 rounded-[2rem] pl-14 pr-6 py-6 focus:outline-none text-2xl font-bold tracking-tight"
					placeholder="Search themes..."
					x-ref="themeSearch"
					x-model="themeQuery"
					@input="searchThemes($event.target.value)"
				/>
			</div>
			<div class="flex-1 overflow-y-auto p-4 space-y-1 theme-list" x-ref="themeList">
				<template x-for="(theme, index) in filteredThemes" :key="theme">
					<div
						class="px-6 py-4 rounded-[1.25rem] cursor-pointer flex justify-between items-center transition-all duration-300 theme-item"
						:class="selectedPaletteIndex === index ? 'bg-primary text-primary-content shadow-xl scale-[1.02] -translate-y-0.5' : (currentTheme === theme ? 'bg-primary/10' : 'hover:bg-base-200')"
						@click="setTheme(theme)"
						@mouseenter="selectedPaletteIndex = index"
						:data-theme-name="theme"
					>
						<div class="flex items-center gap-4">
							<div :data-theme="theme" class="bg-base-100 w-14 h-10 rounded-xl border border-white/10 flex overflow-hidden shadow-sm shrink-0">
								<div class="bg-primary w-1/4 h-full"></div>
								<div class="bg-secondary w-1/4 h-full"></div>
								<div class="bg-accent w-1/4 h-full"></div>
								<div class="bg-neutral w-1/4 h-full"></div>
							</div>
							<div>
								<div class="font-black capitalize leading-none mb-1 text-lg" x-text="theme"></div>
								<div class="text-[10px] uppercase tracking-[0.15em] font-black opacity-40" :class="selectedPaletteIndex === index ? 'text-primary-content/60' : ''" x-text="(['dark', 'gradient-dark', 'synthwave', 'halloween', 'forest', 'aqua', 'black', 'luxury', 'dracula', 'business', 'night', 'coffee', 'dim', 'sunset', 'abyss'].includes(theme) ? 'Dark Theme' : 'Light Theme')"></div>
							</div>
						</div>
						<div class="flex items-center gap-2">
							<span x-show="currentTheme === theme && selectedPaletteIndex !== index" class="text-primary">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
							</span>
							<span x-show="selectedPaletteIndex === index" class="opacity-40">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7" /></svg>
							</span>
						</div>
					</div>
				</template>
			</div>
			<div class="p-6 bg-base-200/50 backdrop-blur-md flex justify-between items-center text-xs uppercase tracking-[0.2em] font-black opacity-40">
				<div class="flex gap-8">
					<span class="flex items-center gap-2"><kbd class="kbd kbd-sm">↑↓</kbd> Navigate</span>
					<span class="flex items-center gap-2"><kbd class="kbd kbd-sm">↵</kbd> Select</span>
				</div>
				<span class="flex items-center gap-2"><kbd class="kbd kbd-sm">Esc</kbd> Close</span>
			</div>
		</div>
	</div>
}
