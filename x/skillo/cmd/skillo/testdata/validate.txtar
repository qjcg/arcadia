env HOME=$WORK/home
mkdir $WORK/home

# Create a valid skill dir
mkdir $WORK/valid-skill
cp valid.md $WORK/valid-skill/SKILL.md

# Create an invalid skill dir
mkdir $WORK/invalid-skill
cp invalid.md $WORK/invalid-skill/SKILL.md

# Test validate on valid skill
skillo validate $WORK/valid-skill
stdout 'Extracted skill: valid-skill'

# Test validate on invalid skill
! skillo validate $WORK/invalid-skill
stderr 'missing name or description'

-- valid.md --
---
name: valid-skill
description: A valid skill
---
# Valid
-- invalid.md --
---
name: invalid-skill
---
# Invalid
