func mandelboxDE(pos vec3) vec4 {
	z := pos
	scale := BoxScale
	if scale == 0.0 {
		scale = 2.0
	}

	dr := 1.0
	orbitTrap := vec3(10000.0)
	minR := 10000.0

	for i := 0; i < 16; i++ {
		if i >= int(Iterations) {
			break
		}

		// Box fold
		z = clamp(z, -1.0, 1.0)*2.0 - z

		// Sphere fold
		r2 := dot(z, z)
		if r2 < 0.25 {
			z = z * 4.0
			dr = dr * 4.0
		} else if r2 < 1.0 {
			z = z / r2
			dr = dr / r2
		}

		z = z*scale + pos
		dr = dr*abs(scale) + 1.0

		r := length(z)
		if r < minR {
			minR = r
			orbitTrap = z
		}
	}

	return vec4(length(z)/abs(dr), dr, orbitTrap.x, orbitTrap.y)
}
