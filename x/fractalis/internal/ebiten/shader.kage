package main

var (
	Resolution  vec2
	Time        float
	CamPos      vec3
	CamPosHi    vec2
	CamPosLo    vec2
	InvZoom     vec2
	UnitToSize  vec2
	Aspect      float
	CamPitch    float
	CamYaw      float
	Power       float
	Iterations  float
	ColorShift  float
	FractalType float // 0: Mandelbulb, 1: Mandelbox, 2+: 2D
	BoxScale    float
	PaintMode   float  // Paint mode: 1-4 inpaint, 5-8 outpaint
)

// Apply paint mode effects to color based on iteration count
// inSet: true if point is in the fractal set (inside), false if exterior
// color: input color to modify
func applyPaintMode(color vec3, inSet bool, iterations float, maxIter float) vec3 {
	if PaintMode < 0.5 {
		return color // No paint mode
	}

	// Inpainting modes (1-4): effects inside the set
	if PaintMode < 4.5 && inSet {
		if PaintMode < 1.5 {
			// Solid inpaint: flat color fill
			return mix(vec3(0.1, 0.2, 0.4), color, 0.3)
		} else if PaintMode < 2.5 {
			// Noisy inpaint: turbulent patterns
			noise := sin(Time * 0.5 + iterations * 0.3) * 0.5 + 0.5
			return color + vec3(noise * 0.2, noise * 0.15, noise * 0.1)
		} else if PaintMode < 3.5 {
			// Iridescent inpaint: color cycling
			irid := sin(Time * 0.3 + iterations * 0.2) * 0.5 + 0.5
			hue := mod(irid + ColorShift * 0.01, 1.0)
			shift := vec3(sin(hue * 6.28), sin((hue + 0.33) * 6.28), sin((hue + 0.67) * 6.28))
			return color * 0.7 + shift * 0.3
		} else {
			// Fractal inpaint: recursive pattern glow
			frac := sin(iterations * 0.5 + Time * 0.2) * 0.5 + 0.5
			return mix(color, vec3(0.8, 0.4, 0.9), frac * 0.4)
		}
	}

	// Outpainting modes (5-8): effects outside the set
	if PaintMode > 4.5 && !inSet {
		normIter := min(iterations / maxIter, 1.0)

		if PaintMode < 5.5 {
			// Glow outpaint: soft halo around fractal
			glow := exp(-normIter * 2.0) * 0.6
			return color + vec3(0.9, 0.7, 0.5) * glow
		} else if PaintMode < 6.5 {
			// Ripple outpaint: wave distortion
			ripple := sin(normIter * 10.0 - Time * 0.5) * 0.3 + 0.7
			return color * ripple + vec3(0.2, 0.3, 0.6) * (1.0 - ripple) * 0.3
		} else if PaintMode < 7.5 {
			// Fog outpaint: misty veil
			fog := 1.0 - exp(-normIter * 1.5)
			return mix(color, vec3(0.5, 0.6, 0.8), fog * 0.5)
		} else {
			// Electric outpaint: discharge arcs
			electric := abs(sin(normIter * 20.0 + Time * 1.5)) * exp(-normIter)
			return color + vec3(0.3, 0.9, 1.0) * electric * 0.8
		}
	}

	return color
}

func sceneSDF(p vec3) float {
	if FractalType > 1.5 {
		boxSize := 10.0
		dBox := length(max(abs(p)-vec3(boxSize), 0.0))
		if dBox > 0.01 {
			return dBox
		}
		return fractal2D_DE(p).x * 0.5
	}
	if FractalType > 0.5 {
		// Bounding box for Mandelbox to help raymarcher find it
		boxSize := 15.0
		dBox := length(max(abs(p)-vec3(boxSize), 0.0))
		if dBox > 0.01 {
			return dBox
		}

		box := mandelboxDE(p)
		return box.x * 0.4 // Even more conservative undershoot for thin surfaces
	}
	bulb := mandelbulbDE(p)
	return bulb.x / bulb.y
}

// Get orbit trap color at position
func getOrbitTrap(p vec3) vec3 {
	if FractalType > 1.5 {
		f2d := fractal2D_DE(p)
		return vec3(f2d.z, f2d.w, 0.0)
	}
	if FractalType > 0.5 {
		box := mandelboxDE(p)
		return vec3(box.z, box.w, 0.0)
	}
	bulb := mandelbulbDE(p)
	return vec3(bulb.z, bulb.w, 0.0)
}

func softShadow(ro vec3, rd vec3, mint float, maxt float, k float) float {
	res := 1.0
	t := mint
	for i := 0; i < 50; i++ {
		if t >= maxt {
			break
		}
		h := sceneSDF(ro + rd*t)
		if h < 0.001 {
			return 0.0
		}
		res = min(res, k*h/t)
		t = t + h
	}
	return res
}

func calcAO(pos vec3, nor vec3) float {
	occ := 0.0
	sca := 1.0
	for i := 0; i < 5; i++ {
		h := 0.01 + 0.12*float(i)/4.0
		d := sceneSDF(pos + h*nor)
		occ = occ + (h-d)*sca
		sca = sca * 0.95
	}
	return clamp(1.0-3.0*occ, 0.0, 1.0)
}

func calcNormal(p vec3) vec3 {
	// Adaptive epsilon for sharper normals at high zoom
	zoomNorm := 1.0
	if Power > 0.0 && FractalType > 1.5 {
		zoomNorm = pow(2.0, Power)
	}
	epsNorm := max(0.0004/zoomNorm, 0.000001)

	e := vec2(epsNorm, 0.0)
	return normalize(vec3(
		sceneSDF(p+e.xyy)-sceneSDF(p-e.xyy),
		sceneSDF(p+e.yxy)-sceneSDF(p-e.yxy),
		sceneSDF(p+e.yyx)-sceneSDF(p-e.yyx),
	))
}

func rayMarch(ro vec3, rd vec3) vec4 {
	// Adaptive hit threshold
	zoomMarch := 1.0
	if Power > 0.0 && FractalType > 1.5 {
		zoomMarch = pow(2.0, Power)
	}
	epsMarch := max(0.0008/zoomMarch, 0.000001)

	t := 0.0
	for i := 0; i < 256; i++ {
		p := ro + rd*t
		d := sceneSDF(p)
		if d < epsMarch {
			return vec4(p, t)
		}
		if t > 100.0 {
			return vec4(0.0)
		}
		t = t + d
	}
	return vec4(0.0)
}

func hsl2rgb(c vec3) vec3 {
	rgb := clamp(abs(mod(c.x*6.0+vec3(0.0, 4.0, 2.0), 6.0)-3.0)-1.0, 0.0, 1.0)
	return c.z + c.y*(rgb-0.5)*(1.0-abs(2.0*c.z-1.0))
}

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	// Normalize coordinates
	uv := (src - 0.5*Resolution) / Resolution.y

	if FractalType > 1.5 {
		// 2x2 Super-Sampling (SSAA) for buttery smooth 2D fractals
		totalCol := vec3(0.0)
		for i := 0; i < 2; i++ {
			for j := 0; j < 2; j++ {
				offset := (vec2(float(i), float(j)) - 0.5) * 0.5
				// Direct 2D path: bypasses raymarching for massive performance boost
				uvSample := src + offset
				f2d := fractal2D_DE(vec3(uvSample.x, 0.0, uvSample.y))
				// f2d.y is now the smooth fractional iteration count
				iter := f2d.y
				// Create a vibrant palette based on smooth iterations
				// Wave-based color offsets for deep, non-static colors
				v := iter * 0.05 + ColorShift * 0.01
				col1 := vec3(0.1, 0.0, 0.2) // Deep Purple
				col2 := vec3(0.0, 0.5, 0.9) // Electric Blue
				col3 := vec3(0.9, 0.1, 0.4) // Hot Pink
				// Cycle through colors
				c := mix(col1, col2, 0.5 + 0.5*sin(v))
				c = mix(c, col3, 0.5 + 0.5*cos(v * 0.8))
				// Interior of the set is black
				inSet := false
				if iter < 1.0 {
					c = vec3(0.0)
					inSet = true
				} else {
					// Use DE for a "glow" effect at the boundary
					dist := f2d.x
					zoom := 1.0
					if Power > 0.0 { zoom = pow(2.0, Power); }
					glow := exp(-dist * 500.0 * zoom)
					c += vec3(0.5, 0.8, 1.0) * glow * 0.5
				}
				// Apply paint modes
				c = applyPaintMode(c, inSet, iter, float(Iterations))
				totalCol += c
			}
		}
		col := totalCol / 4.0
		col = vec3(pow(col.x, 0.4545), pow(col.y, 0.4545), pow(col.z, 0.4545))
		return vec4(col, 1.0)
	}

	// Camera setup
	forward := vec3(
		sin(CamYaw)*cos(CamPitch),
		sin(CamPitch),
		cos(CamYaw)*cos(CamPitch),
	)
	right := vec3(cos(CamYaw), 0.0, -sin(CamYaw))
	up := cross(forward, right)

	ro := CamPos
	rd := normalize(forward + uv.x*right + uv.y*up)

	// Ray march
	hit := rayMarch(ro, rd)

	col := vec3(0.0)

	if hit.w > 0.0 {
		p := hit.xyz
		n := calcNormal(p)

		// Lighting
		lightDir := normalize(vec3(1.0, 0.8, 0.6))
		viewDir := -rd
		halfDir := normalize(lightDir + viewDir)

		// Ambient
		ao := calcAO(p, n)
		ambient := 0.25 * ao

		// Diffuse
		diff := max(dot(n, lightDir), 0.0)

		// Specular - sharper for more detail
		spec := pow(max(dot(n, halfDir), 0.0), 64.0)

		// Soft shadows
		shadow := softShadow(p+n*0.01, lightDir, 0.02, 5.0, 16.0)

		// Multi-layered orbit trap for complex coloring
		trap := getOrbitTrap(p)
		trapLen := length(trap)

		// Spherical coordinates for stripe patterns
		theta := atan2(p.y, p.x)
		phi := acos(clamp(p.z/length(p), -1.0, 1.0))

		// Stripe pattern based on angle and position
		stripes := sin(theta*20.0 + ColorShift*0.1) * 0.5 + 0.5
		stripes = stripes * (sin(phi*15.0) * 0.5 + 0.5)

		// Combine orbit trap with stripes for complex pattern
		pattern := trapLen*0.3 + stripes*0.7

		// Deep purple/pink base with electric blue highlights
		// Base hue in purple range (0.75-0.85)
		hue := fract(0.78 + trapLen*0.1 + ColorShift*0.015)
		hue = hue + stripes*0.08

		// Very high saturation for vivid purples and pinks
		sat := 0.9 + stripes*0.1
		// Much lower lightness to avoid white - deep rich colors
		lightness := ambient*0.3 + diff*shadow*0.25 + spec*shadow*0.15
		lightness = lightness * (0.4 + pattern*0.25)
		// Clamp lightness to prevent white blown-out areas
		lightness = clamp(lightness, 0.05, 0.55)

		col = hsl2rgb(vec3(hue, sat, lightness))

		// Electric blue rim lighting instead of white
		rim := 1.0 - max(dot(n, viewDir), 0.0)
		rim = pow(rim, 3.0)
		col = col + vec3(0.2, 0.5, 1.0)*rim*0.6

		// Teal/cyan iridescence for contrast
		fresnel := pow(1.0 - max(dot(n, viewDir), 0.0), 5.0)
		col = col + vec3(0.0, 0.7, 0.8)*fresnel*0.25

		col = col * ao
		// Apply outpaint effects to the surface (we're outside the set when we hit it)
		col = applyPaintMode(col, false, 100.0, float(Iterations))
	} else {
		// Cosmic starfield and galaxy background
		rdNorm := normalize(rd)

		// Stable noise function for procedural generation
		// Using a simple hash for star placement
		seed := floor(rdNorm * 800.0)
		h := fract(sin(dot(seed, vec3(12.9898, 78.233, 45.164))) * 43758.5453)

		// Background deep space (nearly black with slight blue tint)
		col = vec3(0.002, 0.003, 0.008)

		// Distant stars (static)
		if h > 0.998 {
			brightness := pow(fract(h * 100.0), 10.0) * 2.0
			col += vec3(brightness)
		}

		// Nebula / Galaxy clouds using domain warping
		angle := atan2(rdNorm.z, rdNorm.x)
		elevation := rdNorm.y
		q := vec2(angle * 3.0, elevation * 4.0)

		f1 := sin(q.x + Time*0.05) * sin(q.y + cos(q.x*0.5))
		f2 := sin(q.x*2.1 - Time*0.03) * sin(q.y*1.8 + q.x*0.3)
		nebula := pow(max(f1*f2, 0.0), 3.0)

		// Pink and cyan galaxy colors
		galaxyCol := mix(vec3(0.4, 0.1, 0.6), vec3(0.1, 0.4, 0.8), nebula)
		col += galaxyCol * nebula * 0.4

		// Brighter "star clusters" and interesting space objects
		seed2 := floor(rdNorm * 20.0)
		h2 := fract(sin(dot(seed2, vec3(93.11, 13.73, 52.21))) * 31415.92)
		if h2 > 0.995 {
			dist := length(fract(rdNorm*20.0) - 0.5)
			glow := exp(-dist * 15.0)

			// Some objects are golden/orange (supernovae or planets), some are blue
			objectCol := mix(vec3(1.0, 0.6, 0.2), vec3(0.4, 0.8, 1.0), fract(h2*10.0))
			col += objectCol * glow * 1.5
		}
	}

	// HDR tone mapping
	col = col / (col + 1.0)

	// Gamma correction
	col = vec3(pow(col.x, 0.4545), pow(col.y, 0.4545), pow(col.z, 0.4545))

	return vec4(col, 1.0)
}
