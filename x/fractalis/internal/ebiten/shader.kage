package main

var (
	Resolution  vec2
	Time        float
	CamPos      vec3
	CamPosHi    vec2
	CamPosLo    vec2
	InvZoom     vec2
	UnitToSize  vec2
	Aspect      float
	CamPitch    float
	CamYaw      float
	Power       float
	Iterations  float
	ColorShift  float
	FractalType float // 0: Mandelbulb, 1: Mandelbox, 2+: 2D
	BoxScale    float
	InpaintMode  float  // Inpaint mode: 1-5
	OutpaintMode float  // Outpaint mode: 6-10 (will be normalized to 1-5)
)

// Advanced water simulation functions
// Gerstner wave: creates realistic wave crests and troughs
func gerstnerWave(p vec2, wavelength float, amplitude float, speed float, direction vec2, steepness float) vec3 {
	// Normalize direction
	dir := normalize(direction)

	// Wave parameters
	k := 2.0 * 3.14159 / wavelength
	w := speed * k

	// Gerstner wave displacement
	phase := dot(dir, p) * k - Time * w

	// Horizontal displacement (creates the wave shape)
	disp := dir * amplitude * steepness * cos(phase)

	// Vertical displacement (height of wave)
	height := amplitude * sin(phase)

	return vec3(disp.x, height, disp.y)
}

// Layered ocean surface with multiple harmonics
func oceanSurface(p vec2) vec3 {
	// Combine multiple Gerstner waves at different scales
	result := vec3(0.0)

	// Primary large wave
	result += gerstnerWave(p, 80.0, 0.4, 3.0, vec2(1.0, 0.3), 0.25)

	// Secondary medium wave
	result += gerstnerWave(p, 31.0, 0.15, 2.1, vec2(0.8, -0.6), 0.15)

	// Tertiary small wave (chop)
	result += gerstnerWave(p, 18.0, 0.08, 1.8, vec2(-0.5, 0.9), 0.1)

	// Fine detail waves
	result += gerstnerWave(p, 8.0, 0.03, 1.5, vec2(0.2, 0.8), 0.08)

	return result
}

// Improved Perlin-like noise with multiple octaves
func improvedNoise(p vec3) float {
	p = mod(p, 289.0)
	x := fract(p * 0.00346410161 * 60.0)
	p = floor(p) * 0.00346410161
	f := fract(sin(dot(p, vec3(12.9898, 78.233, 45.164))) * 43758.5453)
	return mix(f, fract(sin(dot(p + 0.1, vec3(12.9898, 78.233, 45.164))) * 43758.5453), x.x)
}

// Caustic pattern - underwater light dancing effect
func caustics(p vec3, t float) float {
	// Create caustic pattern using multiple sine waves
	caustic := 0.0

	// Primary caustic layer
	caustic += 0.5 * sin(p.x * 3.0 + t * 0.5) * sin(p.z * 3.0 + t * 0.3)

	// Secondary caustic detail
	caustic += 0.3 * sin(p.x * 7.0 - t * 0.8) * sin(p.z * 5.0 + t * 0.6)

	// Tertiary fine detail
	caustic += 0.2 * sin(p.x * 12.0 + t * 1.2) * sin(p.z * 11.0 - t * 0.9)

	// Add some turbulence
	caustic += 0.25 * improvedNoise(p + t * 0.2)

	return (caustic + 1.0) / 2.0
}

// Water normal mapping - calculates water surface normals
func waterNormal(p vec2) vec3 {
	epsilon := 0.01

	// Sample ocean surface at three nearby points
	h0 := oceanSurface(p).y
	h1 := oceanSurface(p + vec2(epsilon, 0.0)).y
	h2 := oceanSurface(p + vec2(0.0, epsilon)).y

	// Calculate normal from height differences
	normal := normalize(vec3(
		(h0 - h1) / epsilon,
		epsilon,
		(h0 - h2) / epsilon,
	))

	return normal
}

// Foam generation at wave crests
func foamMask(p vec2) float {
	ocean := oceanSurface(p)

	// Find wave crest (high curvature areas)
	epsilon := 0.5
	h0 := ocean.y
	h1 := oceanSurface(p + vec2(epsilon, 0.0)).y
	h2 := oceanSurface(p + vec2(0.0, epsilon)).y

	// Curvature detection - higher at crests
	curvature := abs((h0 - h1) / epsilon) + abs((h0 - h2) / epsilon)

	// Also add foam persistence using noise
	foamPersistence := 0.5 + 0.5 * sin(improvedNoise(vec3(p * 0.1, Time * 0.1)) * 3.14159)

	// Combine: foam at crests that persists over time
	foam := smoothstep(0.3, 0.8, curvature) * foamPersistence

	return clamp(foam, 0.0, 1.0)
}

// Simple noise function for fog simulation
func fogNoise(p vec3) float {
	// Use vec3 for 3D noise-like effect
	p = p * 0.5 + Time * 0.1
	f := fract(sin(dot(p, vec3(12.9898, 78.233, 45.164))) * 43758.5453)
	return f
}

// Layered Perlin-like noise for cloud generation
func cloudNoise(pos vec3, time float) float {
	pos += time * 0.05
	// Multiple octaves of noise for Fractal Brownian Motion effect
	result := 0.0
	amplitude := 1.0
	frequency := 1.0
	maxAmp := 0.0

	for i := 0; i < 4; i++ {
		sample := fogNoise(pos * frequency)
		result += sample * amplitude
		maxAmp += amplitude
		amplitude *= 0.5
		frequency *= 2.0
	}

	return result / maxAmp
}

// Realistic fire simulation using layered noise and color mapping
func fireNoise(p vec3, t float) float {
	// Offset by time for animation, upward motion creates rising flames
	p.y += t * 0.8
	p = p * 0.3 + vec3(0.0, t * 0.3, 0.0)

	// Multiple octaves for realistic turbulent flames
	result := 0.0
	amplitude := 1.0
	frequency := 1.0
	maxAmp := 0.0

	for i := 0; i < 5; i++ {
		sample := fract(sin(dot(p * frequency, vec3(12.9898, 78.233, 45.164))) * 43758.5453)
		result += sample * amplitude
		maxAmp += amplitude
		amplitude *= 0.5
		frequency *= 2.2
	}

	return result / maxAmp
}

// Convert fire intensity to realistic flame color
func fireColor(intensity float, brightness float) vec3 {
	// Flame color gradient: black -> dark red -> red -> orange -> yellow -> white
	if intensity < 0.25 {
		// Black to dark red
		return mix(vec3(0.0), vec3(0.3, 0.01, 0.0), intensity * 4.0) * brightness
	} else if intensity < 0.45 {
		// Dark red to red
		return mix(vec3(0.3, 0.01, 0.0), vec3(1.0, 0.1, 0.0), (intensity - 0.25) * 5.0) * brightness
	} else if intensity < 0.65 {
		// Red to orange
		return mix(vec3(1.0, 0.1, 0.0), vec3(1.0, 0.5, 0.0), (intensity - 0.45) * 5.0) * brightness
	} else if intensity < 0.85 {
		// Orange to yellow
		return mix(vec3(1.0, 0.5, 0.0), vec3(1.0, 1.0, 0.3), (intensity - 0.65) * 5.0) * brightness
	} else {
		// Yellow to white (hottest)
		return mix(vec3(1.0, 1.0, 0.3), vec3(1.0, 1.0, 1.0), (intensity - 0.85) * 6.67) * brightness
	}
}

// Apply paint mode effects to color based on iteration count
// inSet: true if point is in the fractal set (inside), false if exterior
// color: input color to modify
func applyPaintMode(color vec3, inSet bool, iterations float, maxIter float) vec3 {
	// Apply inpaint effects inside the set
	if InpaintMode > 0.5 && inSet {
		paintMode := InpaintMode
		if paintMode < 1.5 {
			// Solid inpaint: flat color fill
			color = mix(vec3(0.1, 0.2, 0.4), color, 0.3)
		} else if paintMode < 2.5 {
			// Noisy inpaint: turbulent patterns
			noise := sin(Time * 0.5 + iterations * 0.3) * 0.5 + 0.5
			color = color + vec3(noise * 0.2, noise * 0.15, noise * 0.1)
		} else if paintMode < 3.5 {
			// Iridescent inpaint: color cycling
			irid := sin(Time * 0.3 + iterations * 0.2) * 0.5 + 0.5
			hue := mod(irid + ColorShift * 0.01, 1.0)
			shift := vec3(sin(hue * 6.28), sin((hue + 0.33) * 6.28), sin((hue + 0.67) * 6.28))
			color = color * 0.7 + shift * 0.3
		} else if paintMode < 4.5 {
			// Fractal inpaint: recursive pattern glow
			frac := sin(iterations * 0.5 + Time * 0.2) * 0.5 + 0.5
			color = mix(color, vec3(0.8, 0.4, 0.9), frac * 0.4)
		} else {
			// Fire inpaint: molten flames filling the interior
			firePos := vec3(iterations * 0.1, iterations * 0.15, iterations * 0.08)
			fire1 := fireNoise(firePos, Time)
			fire2 := fireNoise(firePos + 50.0, Time * 0.7)
			fire3 := fireNoise(firePos + 100.0, Time * 1.3)

			// Combine multiple fire layers
			fireIntensity := fire1 * 0.6 + fire2 * 0.25 + fire3 * 0.15

			// Create flickering/wavering effect
			flicker := sin(Time * 3.5 + iterations) * 0.5 + 0.5
			fireIntensity += flicker * 0.1

			// Add some structure: higher values near edges, lower in center
			fireIntensity = mix(fireIntensity, 1.0, pow(1.0 - (iterations / maxIter), 0.5) * 0.3)

			// Convert to fire color and blend
			flame := fireColor(fireIntensity, 1.0)
			color = mix(color, flame, clamp(fireIntensity * 0.8, 0.0, 1.0))
		}
	}

	// Apply outpaint effects outside the set
	if OutpaintMode > 0.5 && !inSet {
		paintMode := OutpaintMode - 5.0 // Normalize from 6-10 to 1-5
		normIter := min(iterations / maxIter, 1.0)

		if paintMode < 1.5 {
			// Glow outpaint: soft halo around fractal
			glow := exp(-normIter * 2.0) * 0.6
			color = color + vec3(0.9, 0.7, 0.5) * glow
		} else if paintMode < 2.5 {
			// Ripple outpaint: Hyper-realistic water with waves, caustics, and foam

			// Create world-space position for water simulation
			waterPos := vec2((iterations * 0.5 - Time * 0.2) * normIter, (iterations * 0.3 + Time * 0.1) * normIter)

			// Generate ocean surface displacement and waves
			oceanDisp := oceanSurface(waterPos)

			// Calculate water depth - closer to boundary = shallower
			depth := 1.0 - normIter

			// Water wave refraction - distorts color based on wave surface
			refraction := oceanDisp.xz * 0.3 * (0.5 + 0.5 * sin(Time * 0.5))
			colorDistort := sin((iterations * 0.1 + refraction.x) * normIter) * 0.2 + 0.8

			// Calculate water surface normal for Fresnel effect
			normal := waterNormal(waterPos)
			fresnel := pow(1.0 - abs(normal.y), 2.0)

			// Caustic pattern - underwater light dancing
			causticPattern := caustics(vec3(waterPos * 2.0, oceanDisp.y), Time) * depth

			// Foam mask - white foam at wave crests
			foam := foamMask(waterPos) * exp(-normIter * 2.5)

			// Water color base - rich blues transitioning to cyan
			deepWater := vec3(0.05, 0.1, 0.2)
			shallowWater := vec3(0.1, 0.3, 0.5)
			watColor := mix(deepWater, shallowWater, depth)

			// Add caustic glow
			watColor += vec3(0.2, 0.4, 0.6) * causticPattern

			// Wavelength-based color shift
			wavelengthColor := sin(oceanDisp.y * 3.0 + Time * 0.8) * 0.3
			watColor += vec3(wavelengthColor * 0.1, wavelengthColor * 0.05, 0.0)

			// Apply Fresnel reflection (more reflective at grazing angles)
			skyReflection := mix(vec3(0.3, 0.5, 0.8), vec3(0.9, 0.95, 1.0), fresnel) * fresnel * 0.5
			watColor += skyReflection

			// Blend with original fractal color based on depth
			watColor = mix(watColor, color * colorDistort, depth * 0.5)

			// Add foam - bright white with slightly warm tint
			foamColor := vec3(0.95 + 0.05 * sin(Time * 2.0))
			watColor = mix(watColor, foamColor, foam * 0.8)

			// Add subtle shimmer and sparkle
			sparkle := abs(sin(waterPos.x * 20.0 + Time * 3.0)) * abs(sin(waterPos.y * 20.0 - Time * 2.5))
			watColor += vec3(sparkle * 0.15 * (1.0 - normIter))

			// Depth-based darkening
			watColor *= mix(0.6, 1.0, depth)

			color = watColor
		} else if paintMode < 3.5 {
			// Fog outpaint: realistic moving cloud simulation
			// Create moving cloud layers at different distances
			basePos := vec3(normIter * 5.0, Time * 0.02, normIter * 3.0)
			cloud1 := cloudNoise(basePos, Time * 0.3)
			cloud2 := cloudNoise(basePos + 100.0, Time * 0.2)
			cloud3 := cloudNoise(basePos + 200.0, -Time * 0.25)

			// Blend multiple cloud layers for depth and complexity
			combinedCloud := mix(cloud1, cloud2, 0.5)
			combinedCloud = mix(combinedCloud, cloud3, 0.5)

			// Threshold cloud to create cloud-like appearance
			cloudThreshold := 0.4
			cloudDensity := smoothstep(cloudThreshold - 0.1, cloudThreshold + 0.15, combinedCloud)

			// Modulate cloud density by distance from fractal
			distanceFade := 1.0 - exp(-normIter * 0.8)
			densityModulated := cloudDensity * distanceFade

			// Color variation in clouds - slightly warm/cool tones
			cloudColor := mix(vec3(0.7, 0.75, 0.85), vec3(0.55, 0.65, 0.8), cloud2)
			cloudColor = mix(cloudColor, vec3(0.85, 0.8, 0.9), cloud1 * 0.3)

			// Fog glow near boundary
			boundaryGlow := exp(-normIter * 3.0) * 0.4
			cloudColor += vec3(0.9, 0.85, 0.8) * boundaryGlow

			// Blend clouds with background, thicker near fractal
			color = mix(color, cloudColor, densityModulated * 0.7)
		} else if paintMode < 4.5 {
			// Electric outpaint: discharge arcs
			electric := abs(sin(normIter * 20.0 + Time * 1.5)) * exp(-normIter)
			color = color + vec3(0.3, 0.9, 1.0) * electric * 0.8
		} else {
			// Fire outpaint: realistic flames shooting outward from boundary
			firePos := vec3(normIter * 8.0, normIter * 5.0, normIter * 6.0)
			fire1 := fireNoise(firePos, Time * 1.2)
			fire2 := fireNoise(firePos + 50.0, Time * 0.9)
			fire3 := fireNoise(firePos + 100.0, Time * 1.5)

			// Combine layers with emphasis on higher frequencies for flame detail
			fireIntensity := fire1 * 0.5 + fire2 * 0.3 + fire3 * 0.2

			// Create distinct flame tips that reach outward
			flameTips := sin(normIter * 25.0 + Time * 2.0) * 0.5 + 0.5
			flameReach := exp(-normIter * 2.5) * flameTips
			fireIntensity += flameReach * 0.4

			// Turbulent flickering at the boundaries
			flicker := sin(Time * 4.0 + normIter * 15.0) * 0.5 + 0.5
			fireIntensity += flicker * 0.15

			// Brightest near the boundary, fades quickly outward
			brightness := exp(-normIter * 1.8)
			fireIntensity *= brightness

			// Convert fire intensity to realistic flame color
			flame := fireColor(fireIntensity * 1.2, brightness * 1.3)

			// Blend with original color - flames are bright and opaque
			color = mix(color, flame, clamp(fireIntensity * 1.5, 0.0, 1.0))
		}
	}

	return color
}

func sceneSDF(p vec3) float {
	if FractalType > 1.5 {
		boxSize := 10.0
		dBox := length(max(abs(p)-vec3(boxSize), 0.0))
		if dBox > 0.01 {
			return dBox
		}
		return fractal2D_DE(p).x * 0.5
	}
	if FractalType > 0.5 {
		// Bounding box for Mandelbox to help raymarcher find it
		boxSize := 15.0
		dBox := length(max(abs(p)-vec3(boxSize), 0.0))
		if dBox > 0.01 {
			return dBox
		}

		box := mandelboxDE(p)
		return box.x * 0.4 // Even more conservative undershoot for thin surfaces
	}
	bulb := mandelbulbDE(p)
	return bulb.x / bulb.y
}

// Get orbit trap color at position
func getOrbitTrap(p vec3) vec3 {
	if FractalType > 1.5 {
		f2d := fractal2D_DE(p)
		return vec3(f2d.z, f2d.w, 0.0)
	}
	if FractalType > 0.5 {
		box := mandelboxDE(p)
		return vec3(box.z, box.w, 0.0)
	}
	bulb := mandelbulbDE(p)
	return vec3(bulb.z, bulb.w, 0.0)
}

func softShadow(ro vec3, rd vec3, mint float, maxt float, k float) float {
	res := 1.0
	t := mint
	for i := 0; i < 50; i++ {
		if t >= maxt {
			break
		}
		h := sceneSDF(ro + rd*t)
		if h < 0.001 {
			return 0.0
		}
		res = min(res, k*h/t)
		t = t + h
	}
	return res
}

func calcAO(pos vec3, nor vec3) float {
	occ := 0.0
	sca := 1.0
	for i := 0; i < 5; i++ {
		h := 0.01 + 0.12*float(i)/4.0
		d := sceneSDF(pos + h*nor)
		occ = occ + (h-d)*sca
		sca = sca * 0.95
	}
	return clamp(1.0-3.0*occ, 0.0, 1.0)
}

func calcNormal(p vec3) vec3 {
	// Adaptive epsilon for sharper normals at high zoom
	zoomNorm := 1.0
	if Power > 0.0 && FractalType > 1.5 {
		zoomNorm = pow(2.0, Power)
	}
	epsNorm := max(0.0004/zoomNorm, 0.000001)

	e := vec2(epsNorm, 0.0)
	return normalize(vec3(
		sceneSDF(p+e.xyy)-sceneSDF(p-e.xyy),
		sceneSDF(p+e.yxy)-sceneSDF(p-e.yxy),
		sceneSDF(p+e.yyx)-sceneSDF(p-e.yyx),
	))
}

func rayMarch(ro vec3, rd vec3) vec4 {
	// Adaptive hit threshold
	zoomMarch := 1.0
	if Power > 0.0 && FractalType > 1.5 {
		zoomMarch = pow(2.0, Power)
	}
	epsMarch := max(0.0008/zoomMarch, 0.000001)

	t := 0.0
	for i := 0; i < 256; i++ {
		p := ro + rd*t
		d := sceneSDF(p)
		if d < epsMarch {
			return vec4(p, t)
		}
		if t > 100.0 {
			return vec4(0.0)
		}
		t = t + d
	}
	return vec4(0.0)
}

func hsl2rgb(c vec3) vec3 {
	rgb := clamp(abs(mod(c.x*6.0+vec3(0.0, 4.0, 2.0), 6.0)-3.0)-1.0, 0.0, 1.0)
	return c.z + c.y*(rgb-0.5)*(1.0-abs(2.0*c.z-1.0))
}

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	// Normalize coordinates
	uv := (src - 0.5*Resolution) / Resolution.y

	if FractalType > 1.5 {
		// 2x2 Super-Sampling (SSAA) for buttery smooth 2D fractals
		totalCol := vec3(0.0)
		for i := 0; i < 2; i++ {
			for j := 0; j < 2; j++ {
				offset := (vec2(float(i), float(j)) - 0.5) * 0.5
				// Direct 2D path: bypasses raymarching for massive performance boost
				uvSample := src + offset
				f2d := fractal2D_DE(vec3(uvSample.x, 0.0, uvSample.y))
				// f2d.y is now the smooth fractional iteration count
				iter := f2d.y
				// Create a vibrant palette based on smooth iterations
				// Wave-based color offsets for deep, non-static colors
				v := iter * 0.05 + ColorShift * 0.01
				col1 := vec3(0.1, 0.0, 0.2) // Deep Purple
				col2 := vec3(0.0, 0.5, 0.9) // Electric Blue
				col3 := vec3(0.9, 0.1, 0.4) // Hot Pink
				// Cycle through colors
				c := mix(col1, col2, 0.5 + 0.5*sin(v))
				c = mix(c, col3, 0.5 + 0.5*cos(v * 0.8))
				// Interior of the set is black
				inSet := false
				if iter < 1.0 {
					c = vec3(0.0)
					inSet = true
				} else {
					// Use DE for a "glow" effect at the boundary
					dist := f2d.x
					zoom := 1.0
					if Power > 0.0 { zoom = pow(2.0, Power); }
					glow := exp(-dist * 500.0 * zoom)
					c += vec3(0.5, 0.8, 1.0) * glow * 0.5
				}
				// Apply paint modes
				c = applyPaintMode(c, inSet, iter, float(Iterations))
				totalCol += c
			}
		}
		col := totalCol / 4.0
		col = vec3(pow(col.x, 0.4545), pow(col.y, 0.4545), pow(col.z, 0.4545))
		return vec4(col, 1.0)
	}

	// Camera setup
	forward := vec3(
		sin(CamYaw)*cos(CamPitch),
		sin(CamPitch),
		cos(CamYaw)*cos(CamPitch),
	)
	right := vec3(cos(CamYaw), 0.0, -sin(CamYaw))
	up := cross(forward, right)

	ro := CamPos
	rd := normalize(forward + uv.x*right + uv.y*up)

	// Ray march
	hit := rayMarch(ro, rd)

	col := vec3(0.0)

	if hit.w > 0.0 {
		p := hit.xyz
		n := calcNormal(p)

		// Lighting
		lightDir := normalize(vec3(1.0, 0.8, 0.6))
		viewDir := -rd
		halfDir := normalize(lightDir + viewDir)

		// Ambient
		ao := calcAO(p, n)
		ambient := 0.25 * ao

		// Diffuse
		diff := max(dot(n, lightDir), 0.0)

		// Specular - sharper for more detail
		spec := pow(max(dot(n, halfDir), 0.0), 64.0)

		// Soft shadows
		shadow := softShadow(p+n*0.01, lightDir, 0.02, 5.0, 16.0)

		// Multi-layered orbit trap for complex coloring
		trap := getOrbitTrap(p)
		trapLen := length(trap)

		// Spherical coordinates for stripe patterns
		theta := atan2(p.y, p.x)
		phi := acos(clamp(p.z/length(p), -1.0, 1.0))

		// Stripe pattern based on angle and position
		stripes := sin(theta*20.0 + ColorShift*0.1) * 0.5 + 0.5
		stripes = stripes * (sin(phi*15.0) * 0.5 + 0.5)

		// Combine orbit trap with stripes for complex pattern
		pattern := trapLen*0.3 + stripes*0.7

		// Deep purple/pink base with electric blue highlights
		// Base hue in purple range (0.75-0.85)
		hue := fract(0.78 + trapLen*0.1 + ColorShift*0.015)
		hue = hue + stripes*0.08

		// Very high saturation for vivid purples and pinks
		sat := 0.9 + stripes*0.1
		// Much lower lightness to avoid white - deep rich colors
		lightness := ambient*0.3 + diff*shadow*0.25 + spec*shadow*0.15
		lightness = lightness * (0.4 + pattern*0.25)
		// Clamp lightness to prevent white blown-out areas
		lightness = clamp(lightness, 0.05, 0.55)

		col = hsl2rgb(vec3(hue, sat, lightness))

		// Electric blue rim lighting instead of white
		rim := 1.0 - max(dot(n, viewDir), 0.0)
		rim = pow(rim, 3.0)
		col = col + vec3(0.2, 0.5, 1.0)*rim*0.6

		// Teal/cyan iridescence for contrast
		fresnel := pow(1.0 - max(dot(n, viewDir), 0.0), 5.0)
		col = col + vec3(0.0, 0.7, 0.8)*fresnel*0.25

		col = col * ao
		// Apply outpaint effects to the surface (we're outside the set when we hit it)
		col = applyPaintMode(col, false, 100.0, float(Iterations))
	} else {
		// Cosmic starfield and galaxy background
		rdNorm := normalize(rd)

		// Stable noise function for procedural generation
		// Using a simple hash for star placement
		seed := floor(rdNorm * 800.0)
		h := fract(sin(dot(seed, vec3(12.9898, 78.233, 45.164))) * 43758.5453)

		// Background deep space (nearly black with slight blue tint)
		col = vec3(0.002, 0.003, 0.008)

		// Distant stars (static)
		if h > 0.998 {
			brightness := pow(fract(h * 100.0), 10.0) * 2.0
			col += vec3(brightness)
		}

		// Nebula / Galaxy clouds using domain warping
		angle := atan2(rdNorm.z, rdNorm.x)
		elevation := rdNorm.y
		q := vec2(angle * 3.0, elevation * 4.0)

		f1 := sin(q.x + Time*0.05) * sin(q.y + cos(q.x*0.5))
		f2 := sin(q.x*2.1 - Time*0.03) * sin(q.y*1.8 + q.x*0.3)
		nebula := pow(max(f1*f2, 0.0), 3.0)

		// Pink and cyan galaxy colors
		galaxyCol := mix(vec3(0.4, 0.1, 0.6), vec3(0.1, 0.4, 0.8), nebula)
		col += galaxyCol * nebula * 0.4

		// Brighter "star clusters" and interesting space objects
		seed2 := floor(rdNorm * 20.0)
		h2 := fract(sin(dot(seed2, vec3(93.11, 13.73, 52.21))) * 31415.92)
		if h2 > 0.995 {
			dist := length(fract(rdNorm*20.0) - 0.5)
			glow := exp(-dist * 15.0)

			// Some objects are golden/orange (supernovae or planets), some are blue
			objectCol := mix(vec3(1.0, 0.6, 0.2), vec3(0.4, 0.8, 1.0), fract(h2*10.0))
			col += objectCol * glow * 1.5
		}
	}

	// HDR tone mapping
	col = col / (col + 1.0)

	// Gamma correction
	col = vec3(pow(col.x, 0.4545), pow(col.y, 0.4545), pow(col.z, 0.4545))

	return vec4(col, 1.0)
}
