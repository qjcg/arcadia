package main

var (
	Resolution  vec2
	Time        float
	CamPos      vec3
	CamPitch    float
	CamYaw      float
	Power       float
	Iterations  float
	ColorShift  float
	FractalType float // 0: Mandelbulb, 1: Mandelbox
	BoxScale    float
)

func sceneSDF(p vec3) float {
	if FractalType > 0.5 {
		box := mandelboxDE(p)
		return box.x
	}
	bulb := mandelbulbDE(p)
	return bulb.x / bulb.y
}

// Get orbit trap color at position
func getOrbitTrap(p vec3) vec3 {
	if FractalType > 0.5 {
		box := mandelboxDE(p)
		return vec3(box.z, box.w, 0.0)
	}
	bulb := mandelbulbDE(p)
	return vec3(bulb.z, bulb.w, 0.0)
}

func softShadow(ro vec3, rd vec3, mint float, maxt float, k float) float {
	res := 1.0
	t := mint
	for i := 0; i < 50; i++ {
		if t >= maxt {
			break
		}
		h := sceneSDF(ro + rd*t)
		if h < 0.001 {
			return 0.0
		}
		res = min(res, k*h/t)
		t = t + h
	}
	return res
}

func calcAO(pos vec3, nor vec3) float {
	occ := 0.0
	sca := 1.0
	for i := 0; i < 5; i++ {
		h := 0.01 + 0.12*float(i)/4.0
		d := sceneSDF(pos + h*nor)
		occ = occ + (h-d)*sca
		sca = sca * 0.95
	}
	return clamp(1.0-3.0*occ, 0.0, 1.0)
}

func calcNormal(p vec3) vec3 {
	e := vec2(0.001, 0.0)
	return normalize(vec3(
		sceneSDF(p+e.xyy)-sceneSDF(p-e.xyy),
		sceneSDF(p+e.yxy)-sceneSDF(p-e.yxy),
		sceneSDF(p+e.yyx)-sceneSDF(p-e.yyx),
	))
}

func rayMarch(ro vec3, rd vec3) vec4 {
	t := 0.0
	for i := 0; i < 100; i++ {
		p := ro + rd*t
		d := sceneSDF(p)
		if d < 0.001 {
			return vec4(p, t)
		}
		if t > 20.0 {
			return vec4(0.0)
		}
		t = t + d
	}
	return vec4(0.0)
}

func hsl2rgb(c vec3) vec3 {
	rgb := clamp(abs(mod(c.x*6.0+vec3(0.0, 4.0, 2.0), 6.0)-3.0)-1.0, 0.0, 1.0)
	return c.z + c.y*(rgb-0.5)*(1.0-abs(2.0*c.z-1.0))
}

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	// Normalize coordinates
	uv := (src - 0.5*Resolution) / Resolution.y

	// Camera setup
	forward := vec3(
		sin(CamYaw)*cos(CamPitch),
		sin(CamPitch),
		cos(CamYaw)*cos(CamPitch),
	)
	right := vec3(cos(CamYaw), 0.0, -sin(CamYaw))
	up := cross(forward, right)

	ro := CamPos
	rd := normalize(forward + uv.x*right + uv.y*up)

	// Ray march
	hit := rayMarch(ro, rd)

	col := vec3(0.0)

	if hit.w > 0.0 {
		p := hit.xyz
		n := calcNormal(p)

		// Lighting
		lightDir := normalize(vec3(1.0, 0.8, 0.6))
		viewDir := -rd
		halfDir := normalize(lightDir + viewDir)

		// Ambient
		ao := calcAO(p, n)
		ambient := 0.15 * ao

		// Diffuse
		diff := max(dot(n, lightDir), 0.0)

		// Specular - sharper for more detail
		spec := pow(max(dot(n, halfDir), 0.0), 64.0)

		// Soft shadows
		shadow := softShadow(p+n*0.01, lightDir, 0.02, 5.0, 16.0)

		// Multi-layered orbit trap for complex coloring
		trap := getOrbitTrap(p)
		trapLen := length(trap)

		// Spherical coordinates for stripe patterns
		theta := atan2(p.y, p.x)
		phi := acos(clamp(p.z/length(p), -1.0, 1.0))

		// Stripe pattern based on angle and position
		stripes := sin(theta*20.0 + ColorShift*0.1) * 0.5 + 0.5
		stripes = stripes * (sin(phi*15.0) * 0.5 + 0.5)

		// Combine orbit trap with stripes for complex pattern
		pattern := trapLen*0.3 + stripes*0.7

		// Deep purple/pink base with electric blue highlights
		// Base hue in purple range (0.75-0.85)
		hue := fract(0.78 + trapLen*0.1 + ColorShift*0.015)
		hue = hue + stripes*0.08

		// Very high saturation for vivid purples and pinks
		sat := 0.9 + stripes*0.1
		// Much lower lightness to avoid white - deep rich colors
		lightness := ambient*0.3 + diff*shadow*0.25 + spec*shadow*0.15
		lightness = lightness * (0.4 + pattern*0.25)
		// Clamp lightness to prevent white blown-out areas
		lightness = clamp(lightness, 0.05, 0.55)

		col = hsl2rgb(vec3(hue, sat, lightness))

		// Electric blue rim lighting instead of white
		rim := 1.0 - max(dot(n, viewDir), 0.0)
		rim = pow(rim, 3.0)
		col = col + vec3(0.2, 0.5, 1.0)*rim*0.6

		// Teal/cyan iridescence for contrast
		fresnel := pow(1.0 - max(dot(n, viewDir), 0.0), 5.0)
		col = col + vec3(0.0, 0.7, 0.8)*fresnel*0.25

		col = col * ao
	} else {
		// Nebula background for rays that don't hit the fractal
		// Create an epic, organic cosmic background
		rdNorm := normalize(rd)
		angle := atan2(rdNorm.z, rdNorm.x)
		elevation := rdNorm.y

		// Base gradient: Deep space richness
		bgMix := elevation * 0.5 + 0.5
		bgCol := mix(vec3(0.02, 0.01, 0.05), vec3(0.01, 0.03, 0.08), bgMix)

		// Domain warping for organic filaments
		// Layer 1: Base motion
		q := vec2(angle * 2.0, elevation * 3.0)
		r := vec2(
			sin(q.x + q.y + Time*0.1),
			sin(q.x - q.y - Time*0.15),
		)

		// Layer 2: Detail warping
		s := vec2(
			sin(q.x*4.0 + r.x*3.0 + Time*0.05),
			sin(q.y*4.0 + r.y*3.0),
		)

		// Organic nebula intensity
		nebVal1 := sin(q.x*3.0 + s.x*2.0) * sin(q.y*3.0 + s.y*2.0) * 0.5 + 0.5
		nebVal2 := sin(q.x*7.0 + r.y*4.0) * sin(q.y*5.0 + r.x*4.0) * 0.5 + 0.5

		// Epic nebula colors: Magenta-cyan-gold
		nebula := vec3(0.0)
		nebula += vec3(0.7, 0.1, 0.5) * pow(nebVal1, 3.0) * 0.4  // Deep magenta filaments
		nebula += vec3(0.1, 0.6, 0.8) * pow(nebVal2, 4.0) * 0.35 // Cyan gas clouds
		nebula += vec3(0.9, 0.5, 0.2) * pow(nebVal1 * nebVal2, 2.0) * 0.2 // Golden dust

		// Add starfield with varying sizes and "shimmer"
		starSeed1 := sin(angle*150.0) * sin(elevation*150.0)
		starSeed2 := sin(angle*80.0) * sin(elevation*200.0)

		starField1 := pow(max(starSeed1, 0.0), 30.0) * 2.5
		starField2 := pow(max(starSeed2, 0.0), 50.0) * 4.0 // Bigger hero stars

		// Pulsating hero stars
		shimmer := sin(Time*2.0 + angle*10.0) * 0.5 + 0.5
		stars := vec3(starField1) + vec3(0.6, 0.8, 1.0) * starField2 * (0.7 + 0.3*shimmer)

		col = bgCol + nebula*0.8 + stars
	}

	// HDR tone mapping
	col = col / (col + 1.0)

	// Gamma correction
	col = vec3(pow(col.x, 0.4545), pow(col.y, 0.4545), pow(col.z, 0.4545))

	return vec4(col, 1.0)
}
