// SDF for 2D fractals
func fractal2D_DE(p vec3) vec4 {
	// Project 3D point to 2D plane (Z = 0)
	// Map X, Z to 2D coordinates, Y is distance from plane
	// NOTE: In direct 2D mode, p.xz is already the offset from CamPos
	zoom := 1.0
	if Power > 0.0 {
		zoom = pow(2.0, Power)
	}

	c := p.xz*(1.5/zoom) + CamPos.xz

	z := vec2(0.0)
	if FractalType == 3.0 { // Julia
		z = c
		c = vec2(-0.7, 0.27015) // Default Julia constant
	}

	dr := 1.0
	r := 0.0
	iterations := Iterations
	if iterations < 1.0 {
		iterations = 32.0
	}

	finalIter := 0.0
	for i := 0; i < 512; i++ {
		finalIter = float(i)
		if i >= int(iterations) {
			break
		}

		r = length(z)
		if r > 20.0 {
			break
		}

		zr := z.x
		zi := z.y
		zr2 := zr * zr
		zi2 := zi * zi

		if FractalType == 2.0 || FractalType == 3.0 { // Mandelbrot / Julia
			z = vec2(zr2-zi2, 2.0*zr*zi) + c
			dr = 2.0*r*dr + 1.0
		} else if FractalType == 4.0 { // Burning Ship
			z = vec2(zr2-zi2, 2.0*abs(zr)*abs(zi)) + c
			dr = 2.0*r*dr + 1.0
		} else if FractalType == 5.0 { // Tricorn
			z = vec2(zr2-zi2, -2.0*zr*zi) + c
			dr = 2.0*r*dr + 1.0
		} else if FractalType == 6.0 { // Multibrot 3
			z = vec2(zr*(zr2-3.0*zi2), zi*(3.0*zr2-zi2)) + c
			dr = 3.0*r*r*dr + 1.0
		} else if FractalType == 7.0 { // Multibrot 4
			zrSq := zr2 - zi2
			ziSq := 2.0 * zr * zi
			z = vec2(zrSq*zrSq-ziSq*ziSq, 2.0*zrSq*ziSq) + c
			dr = 4.0*r*r*r*dr + 1.0
		} else if FractalType == 8.0 { // Celtic
			nZr := zr2 - zi2
			nZi := 2.0 * zr * zi
			z = vec2(abs(nZr), nZi) + c
			dr = 2.0*r*dr + 1.0
		} else if FractalType == 9.0 { // Perpendicular
			nZr := zr2 - zi2
			nZi := -2.0 * abs(zr*zi)
			z = vec2(nZr, nZi) + c
			dr = 2.0*r*dr + 1.0
		} else if FractalType == 10.0 { // Manhattan
			z = vec2(zr2-zi2, 2.0*zr*zi) + c
			dr = 2.0*r*dr + 1.0
			if abs(z.x)+abs(z.y) > 4.0 {
				break
			}
		}
	}

	m2 := dot(z,z)
	if m2 > 1000.0 {
		sl := finalIter - log2(log2(m2)) + 4.0
		r = sl
	} else if finalIter >= Iterations-1.0 {
		r = 0.0 // Interior
	} else {
		r = finalIter
	}

	// Distance estimation found in 2D fractals: 0.5 * log(r) * r / dr
	d := 0.5 * log(length(z)) * length(z) / dr

	// Add thickness to the 2D plane
	planeD := abs(p.y)
	return vec4(max(d, planeD), r, z.x, z.y)
}
