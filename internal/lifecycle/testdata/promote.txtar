# Promotion moves exp/foo to cmd/foo, rewrites the module path and imports,
# lands one commit, and cuts the cmd/foo/v1.0.0 tag.

exec git init -q
exec git config user.email test@example.com
exec git config user.name test
exec git add -A
exec git commit -q -m 'feat: add foo'

# An untracked file is also a dirty tree and must not be swept into the commit.
exec touch untracked.txt
! exec sh $LIFECYCLE/promote.sh foo
stderr 'working tree is not clean'
exec rm untracked.txt

exec sh $LIFECYCLE/promote.sh foo
stdout 'promote: promoted exp/foo -> cmd/foo at v1.0.0'

# The move happened.
! exists exp/foo
exists cmd/foo/main.go

# Module path and imports were rewritten.
grep 'module github.com/qjcg/arcadia/cmd/foo' cmd/foo/go.mod
grep '"github.com/qjcg/arcadia/cmd/foo/sub"' cmd/foo/main.go

# go.work follows the module.
grep '\./cmd/foo' go.work
! grep '\./exp/foo' go.work

# One commit, tagged at v1.0.0.
exec git log -1 --pretty=%s
stdout 'feat\(foo\)!: promote exp/foo to cmd/foo at v1.0.0'
exec git tag -l cmd/foo/v1.0.0
stdout 'cmd/foo/v1.0.0'

# Policy is green afterwards.
exec sh $LIFECYCLE/check.sh
stdout 'policy OK'

-- go.work --
go 1.27.1

use (
	.
	./exp/foo
)

-- go.mod --
module github.com/qjcg/arcadia

go 1.27.1

-- exp/foo/go.mod --
module github.com/qjcg/arcadia/exp/foo

go 1.27.1

-- exp/foo/main.go --
package main

import "github.com/qjcg/arcadia/exp/foo/sub"

func main() { sub.Hi() }

-- exp/foo/sub/sub.go --
package sub

func Hi() {}

-- exp/foo/README.md --
# foo

An experiment.

-- exp/foo/CHANGELOG.md --
# Changelog
