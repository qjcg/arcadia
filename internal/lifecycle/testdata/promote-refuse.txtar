# Promotion refuses to touch an experiment that fails the mechanical
# checklist, and leaves the tree untouched.

exec git init -q
exec git config user.email test@example.com
exec git config user.name test
exec git add -A
exec git commit -q -m 'feat: add foo'

# No README.md: refused.
! exec sh $LIFECYCLE/promote.sh foo
stderr 'README.md is missing'
exists exp/foo/main.go

# Unknown name: refused.
! exec sh $LIFECYCLE/promote.sh nope
stderr 'does not exist'

# Reject path traversal before touching the repository.
! exec sh $LIFECYCLE/promote.sh ../go.mod
stderr 'name must contain only lowercase letters, digits, and hyphens'
exists go.mod

# Not a module: refused.
! exec sh $LIFECYCLE/promote.sh bar
stderr 'is not a Go module'
exists exp/bar/main.go

# Nothing was committed or tagged by the failed runs.
exec git log -1 --pretty=%s
stdout 'feat: add foo'
exec git tag -l
! stdout .

-- go.work --
go 1.27.1

use (
	.
	./exp/foo
)

-- go.mod --
module github.com/qjcg/arcadia

go 1.27.1

-- exp/foo/go.mod --
module github.com/qjcg/arcadia/exp/foo

go 1.27.1

-- exp/foo/main.go --
package main

func main() {}

-- exp/bar/main.go --
package main

func main() {}
