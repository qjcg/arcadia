env HOME=$WORK/home
mkdir -p $WORK/home

# Initialize skillo
skillo init

# Create selections + skills dir for module+version info
mkdir -p $HOME/.agents/skills/my-skill
mkdir -p $HOME/.agents/skills/plain-skill

# List should show skill names
skillo list
stdout 'my-skill'

# plain-skill has no description, should still appear
stdout 'plain-skill'
-- home/.config/skillo/selections.json --
{"github.com/example/repo":["my-skill"]}
-- home/.agents/skills/my-skill/SKILL.md --
---
name: my-skill
description: A useful test skill
license: MIT
---

# My Skill