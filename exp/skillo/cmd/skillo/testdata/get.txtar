env HOME=$WORK/home
mkdir $WORK/home

# Initialize skillo
skillo init

# Test get with real GitHub repo (arcadia monorepo) using @latest
# Note: arcadia now includes agents/skills/ with SKILL.md files
skillo get github.com/qjcg/arcadia@latest
stdout 'Installed github.com/qjcg/arcadia@latest'

# Verify module was installed
grep 'github.com/qjcg/arcadia' $WORK/home/.skillo/go.mod

# Test get with specific version
skillo get github.com/qjcg/arcadia@v0.29.0
stdout 'Installed github.com/qjcg/arcadia@v0.29.0'
