env HOME=$WORK/home
mkdir $WORK/home

# Initialize skillo
skillo init

# Create a git repo to simulate project context
mkdir -p $WORK/myproject/.git
mkdir -p $WORK/myproject/.agents/skills/proj-skill

# Create user-level skills too
mkdir -p $HOME/.agents/skills/user-skill

# cd into project and list — should show project skills first, user skills with (user)
cd $WORK/myproject
skillo list
stdout 'proj-skill'
stdout 'user-skill'
! stdout 'proj-skill.*(user)'

# List with --scope project shows only project skills
skillo list --scope project
stdout 'proj-skill'
! stdout 'user-skill'

# List with --scope user shows only user skills
skillo list --scope user
stdout 'user-skill'
! stdout 'proj-skill'

# When same name exists in both, project wins (no (user) suffix)
mkdir -p $WORK/myproject/.agents/skills/overlap-skill
mkdir -p $HOME/.agents/skills/overlap-skill
skillo list
stdout 'overlap-skill'
! stdout 'overlap-skill (user)'