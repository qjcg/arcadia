env HOME=$WORK/home
mkdir $WORK/home

# Setup some skills
mkdir -p $WORK/home/.config/agents/skills/pdf-skill
mkdir -p $WORK/home/.config/agents/skills/text-skill

# Search for pdf
skillo search pdf
stdout 'pdf-skill'
! stdout 'text-skill'

# Search for skill
skillo search skill
stdout 'pdf-skill'
stdout 'text-skill'

# Verify placeholder message
stdout 'GitHub search integration coming soon'
