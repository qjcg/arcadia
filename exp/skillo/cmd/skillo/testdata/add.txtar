env HOME=$WORK/home

# Create a fake Go module with a skill
mkdir -p $HOME

# Initialize skillo workspace
skillo init

# Add replace directive so go get resolves locally
cd $HOME/.config/skillo
exec go mod edit -replace example.com/fake=$WORK/fakemodule
exec go mod tidy

# Run add with the fake module (no version = @latest)
cd $WORK
skillo add example.com/fake
stdout 'Installed example.com/fake@latest'
stdout 'Extracted skill: my-skill'
stdout 'Extracted skill: other-skill'

# Verify skills were extracted
exists $HOME/.agents/skills/my-skill/SKILL.md
exists $HOME/.agents/skills/other-skill/SKILL.md

# Verify selections.json was written
grep 'example.com/fake' $HOME/.config/skillo/selections.json

# List should show the skills
skillo list
stdout 'my-skill'
stdout 'other-skill'
-- fakemodule/go.mod --
module example.com/fake

go 1.26
-- fakemodule/myskill/SKILL.md --
---
name: my-skill
description: A test skill
---

# My Skill
-- fakemodule/otherskill/SKILL.md --
---
name: other-skill
description: Another skill
---

# Other