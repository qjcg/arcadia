env HOME=$WORK/home
mkdir $WORK/home

# First init creates ~/.config/skillo/
skillo init
stdout 'initialized at'
exists $HOME/.config/skillo/go.mod
exists $HOME/.config/skillo/selections.json
grep 'module skillo.local/skills' $HOME/.config/skillo/go.mod

# Second init should be idempotent-ish
skillo init
stdout 'workspace already initialized at'