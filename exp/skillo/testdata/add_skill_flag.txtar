env HOME=$WORK/home
mkdir -p $HOME

# Initialize skillo workspace
skillo init

# Add replace directive so go get resolves locally
cd $HOME/.config/skillo
exec go mod edit -replace example.com/fake=$WORK/fakemodule
exec go mod tidy

# Run add with --skill flag to install only one skill
cd $WORK
skillo add example.com/fake --skill my-skill
stdout 'Installed example.com/fake@latest'
stdout 'Extracted skill: my-skill'
! stdout 'Extracted skill: other-skill'

# Only my-skill should exist
exists $HOME/.agents/skills/my-skill/SKILL.md
! exists $HOME/.agents/skills/other-skill

# selections.json should only list my-skill
grep 'my-skill' $HOME/.config/skillo/selections.json
! grep 'other-skill' $HOME/.config/skillo/selections.json
-- fakemodule/go.mod --
module example.com/fake

go 1.26
-- fakemodule/myskill/SKILL.md --
---
name: my-skill
description: A test skill
---

# My Skill
-- fakemodule/otherskill/SKILL.md --
---
name: other-skill
description: Another skill
---

# Other