env HOME=$WORK/home
mkdir $WORK/home

# Initialize skillo
skillo init

# Empty list (no skills installed yet) — header shows
skillo list
stdout 'SKILL'
stdout 'STATUS'
! stdout 'test-skill'

# Create a fake skill directory to test listing
mkdir -p $HOME/.agents/skills/test-skill

# List should show the skill (as orphaned since not in selections)
skillo list
stdout 'test-skill'