-- name: InsertURL :exec
INSERT INTO urls (short_code, original_url, expires_at) VALUES (?, ?, ?);

-- name: GetByShortCode :one
SELECT id, short_code, original_url, expires_at, created_at FROM urls WHERE short_code = ?;

-- name: ListRecent :many
SELECT short_code, original_url, expires_at, created_at FROM urls ORDER BY created_at DESC LIMIT 20;

-- name: DeleteURL :exec
DELETE FROM urls WHERE short_code = ?;
