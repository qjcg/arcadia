version: "3"

tasks:
  default:
    desc: Build and run the server
    cmds:
      - task: build
      - ./{{.project_name}}

  build:
    desc: Generate templ code and build the binary
    cmds:
      - go tool templ generate
      - go build -o {{.project_name}} .

  dev:
    desc: Run with live reload (requires air)
    cmds:
      - air --build.cmd "go tool templ generate && go build -o {{.project_name}} ." --build.bin "./{{.project_name}}"

  test:
    desc: Run all tests
    cmds:
      - go tool templ generate
      - go test ./...

  templ:
    desc: Regenerate templ code
    cmds:
      - go tool templ generate
