<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{.Title}} &mdash; Pavona</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
    :root { --bg: #f8fafc; --bg-card: #ffffff; --border: #e2e8f0; --text: #1e293b; --text-muted: #64748b; --link: #2563eb; --code-bg: #f1f5f9; --code-color: #dc2626; --pre-bg: #1e293b; --pre-color: #e2e8f0; }
    [data-theme="dark"] { --bg: #0f172a; --bg-card: #1e293b; --border: #334155; --text: #e2e8f0; --text-muted: #94a3b8; --link: #60a5fa; --code-bg: #334155; --code-color: #f87171; --pre-bg: #0f172a; --pre-color: #cbd5e1; }
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text); transition: background 0.2s, color 0.2s; }
    code, pre { font-family: 'JetBrains Mono', monospace; }
    .prose h1 { font-size: 2.25rem; font-weight: 700; margin-bottom: 1rem; }
    .prose h2 { font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--border); padding-bottom: 0.375rem; }
    .prose h3 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; }
    .prose p { margin-bottom: 1rem; line-height: 1.75; }
    .prose a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }
    .prose a:hover { opacity: 0.8; }
    .prose ul, .prose ol { margin-bottom: 1rem; padding-left: 1.5rem; }
    .prose li { margin-bottom: 0.25rem; line-height: 1.75; }
    .prose code { background: var(--code-bg); padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875rem; color: var(--code-color); }
    .prose pre { background: var(--pre-bg); color: var(--pre-color); padding: 1rem; border-radius: 0.5rem; overflow-x: auto; margin-bottom: 1rem; font-size: 0.875rem; line-height: 1.5; }
    .prose pre code { background: transparent; color: inherit; padding: 0; border-radius: 0; font-size: inherit; }
    .prose blockquote { border-left: 4px solid var(--link); padding-left: 1rem; margin-bottom: 1rem; color: var(--text-muted); font-style: italic; }
    .prose img { max-width: 100%; border-radius: 0.5rem; margin: 1.5rem 0; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
    .prose hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }
    .prose table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
    .prose th { background: var(--code-bg); font-weight: 600; text-align: left; padding: 0.5rem 0.75rem; border: 1px solid var(--border); }
    .prose td { padding: 0.5rem 0.75rem; border: 1px solid var(--border); }
    .outline-2, .outline-3, .outline-4 { margin-bottom: 1rem; }
    .outline-text-2, .outline-text-3, .outline-text-4 { margin-left: 0.5rem; }
    .title { font-size: 2.25rem; font-weight: 700; margin-bottom: 0.5rem; }
    /* Theme toggle button */
    .theme-btn { background: none; border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.375rem; cursor: pointer; color: var(--text-muted); display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
    .theme-btn:hover { background: var(--code-bg); }
    .theme-btn svg { width: 18px; height: 18px; }
    /* Nav */
    .nav-link { color: var(--text-muted); }
    .nav-link:hover { color: var(--text); background: var(--code-bg); }
    /* Search */
    #search-container { position: relative; }
    #search-results a { display: block; padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--border); color: var(--text); text-decoration: none; transition: background 0.15s; }
    #search-results a:last-child { border-bottom: none; }
    #search-results a:hover { background: var(--code-bg); }
    #search-results .result-title { font-weight: 600; font-size: 0.875rem; }
    #search-results .result-snippet { font-size: 0.75rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #search-results .result-empty { padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.875rem; }
  </style>
</head>
<body class="min-h-screen" style="background: var(--bg); color: var(--text); transition: background 0.2s, color 0.2s;">
  <header class="sticky top-0 z-10" style="border-bottom: 1px solid var(--border); background: var(--bg-card); backdrop-filter: blur(8px); transition: background 0.2s;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="text-lg font-bold hover:opacity-80 transition-opacity no-underline" style="color: var(--text);">&#127754; Pavona</a>
        <div class="flex items-center gap-1">
          <nav class="flex gap-1">
            {{range .Nav.Children}}
            {{if ne .URL "index.html"}}
            <div class="relative group">
              <a href="/{{.URL}}" class="nav-link px-3 py-1.5 text-sm font-medium rounded-lg no-underline transition-colors inline-block">{{.Title}}</a>
              {{if .Children}}
              <ul class="nav-dropdown absolute hidden group-hover:block top-full left-0 border rounded-lg shadow-lg py-1 min-w-[10rem] z-20" style="border-color: var(--border); background: var(--bg-card);">
                {{range .Children}}
                <li><a href="/{{.URL}}" class="block px-3 py-1.5 text-sm no-underline transition-colors" style="color: var(--text-muted);">{{.Title}}</a></li>
                {{end}}
              </ul>
              {{end}}
            </div>
            {{end}}
            {{end}}
          </nav>
          <div style="position:relative" id="search-container">
            <input type="search" id="search-input" placeholder="Search..." style="width:9rem; padding:0.25rem 0.625rem; font-size:0.875rem; background:var(--code-bg); border:1px solid var(--border); border-radius:0.5rem; color:var(--text); outline:none;" onfocus="this.style.borderColor='var(--link)'" onblur="this.style.borderColor=''"/>
            <div id="search-results" class="search-results" style="display:none; position:absolute; right:0; top:100%; margin-top:0.25rem; width:18rem; background:var(--bg-card); border:1px solid var(--border); border-radius:0.5rem; box-shadow:0 10px 25px rgba(0,0,0,0.15); max-height:20rem; overflow-y:auto; z-index:50;"></div>
          </div>
          <button id="theme-toggle" class="theme-btn" onclick="cycleTheme()" aria-label="Switch theme">
            <svg id="icon-system" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <svg id="icon-light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg id="icon-dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
      </div>
    </div>
  </header>
  <main style="max-width: 56rem; margin: 0 auto; padding: 3rem 1rem;">
    <article class="prose" style="max-width: none;">
      {{.Content}}
    </article>
  </main>
  <footer style="border-top: 1px solid var(--border); margin-top: 3rem; transition: border-color 0.2s;">
    <div style="max-width: 56rem; margin: 0 auto; padding: 2rem 1rem; text-align: center; font-size: 0.875rem; opacity: 0.6;">
      Built with &hearts; using <a href="https://github.com/qjcg/arcadia" style="text-decoration: underline;">Pavona</a>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/flexsearch@0.8.105/dist/flexsearch.bundle.min.js"></script>
  <script>
    var flexIndex = null;
    var searchData = null;

    function initSearch(data) {
      searchData = data;
      flexIndex = new FlexSearch.Document({
        document: { id: 'id', index: ['title', 'content'], store: ['title', 'url'] },
        tokenize: 'forward'
      });
      for (var i = 0; i < data.length; i++) {
        flexIndex.add(data[i]);
      }
    }

    function performSearch(query) {
      var container = document.getElementById('search-results');
      if (!flexIndex || query.length < 2) {
        container.style.display = 'none';
        return;
      }
      var results = flexIndex.search(query, { limit: 10, enrich: true });
      var hits = [];
      var seen = {};
      for (var f = 0; f < results.length; f++) {
        for (var r = 0; r < results[f].result.length; r++) {
          var item = results[f].result[r];
          if (!seen[item.id]) {
            seen[item.id] = true;
            hits.push(item);
          }
        }
      }
      if (hits.length === 0) {
        container.innerHTML = '<div class="result-empty" style="padding:1rem; text-align:center; color:var(--text-muted); font-size:0.875rem;">No results found</div>';
        container.style.display = 'block';
        return;
      }
      var html = '';
      for (var i = 0; i < hits.length; i++) {
        var doc = searchData[hits[i].id];
        var snippet = doc.content.substring(0, 120);
        html += '<a href="/' + doc.url + '" style="display:block; padding:0.625rem 0.75rem; border-bottom:1px solid var(--border); color:var(--text); text-decoration:none;"><div style="font-weight:600; font-size:0.875rem;">' + doc.title + '</div><div style="font-size:0.75rem; color:var(--text-muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">' + snippet + '</div></a>';
      }
      container.innerHTML = html;
      container.style.display = 'block';
    }

    function getTheme(){return localStorage.getItem('theme')||'system'}
    function setTheme(t){localStorage.setItem('theme',t);applyTheme(t)}
    function applyTheme(t){
      var h=document.documentElement;
      if(t==='system'){h.setAttribute('data-theme',window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}
      else{h.setAttribute('data-theme',t)}
      updateIcon(t)
    }
    function updateIcon(t){
      document.getElementById('icon-system').style.display=t==='system'?'':'none';
      document.getElementById('icon-light').style.display=t==='light'?'':'none';
      document.getElementById('icon-dark').style.display=t==='dark'?'':'none';
    }
    function cycleTheme(){var a=['system','light','dark'],c=getTheme();setTheme(a[(a.indexOf(c)+1)%3])}
    document.addEventListener('DOMContentLoaded',function(){
      applyTheme(getTheme());
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){if(getTheme()==='system')applyTheme('system')});
      fetch('/search-index.json').then(function(r){return r.json()}).then(function(data){initSearch(data)});
      var si=document.getElementById('search-input'),sr=document.getElementById('search-results'),dt=null,isMac=navigator.platform.toUpperCase().indexOf('MAC')>=0;
      si.placeholder='Search...  ('+(isMac?'Cmd':'Ctrl')+'+K)';
      si.addEventListener('input',function(){clearTimeout(dt);dt=setTimeout(function(){performSearch(si.value.trim())},150)});
      si.addEventListener('focus',function(){if(si.value.trim().length>=2)sr.style.display='block'});
      document.addEventListener('click',function(e){if(!document.getElementById('search-container').contains(e.target))sr.style.display='none'});
      si.addEventListener('keydown',function(e){if(e.key==='Escape')sr.style.display='none'});
      document.addEventListener('keydown',function(e){if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();si.focus()}});
    });
  </script>
</body>
</html>
