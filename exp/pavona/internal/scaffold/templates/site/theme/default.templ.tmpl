package theme

type Page struct {
	URL   string
	Title string
}

templ Layout(title string, content string, pages []Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme="system">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } &mdash; {{.SiteName}}</title>
			<link rel="stylesheet" href="/style.css"/>
			<style>
				@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');
				body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
				code, pre { font-family: 'JetBrains Mono', monospace; }
				.prose { color: oklch(var(--bc)); }
				.prose h1 { font-size: 2.25rem; font-weight: 700; margin-bottom: 1rem; color: oklch(var(--bc)); }
				.prose h2 { font-size: 1.5rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: oklch(var(--bc)); border-bottom: 2px solid oklch(var(--b3)); padding-bottom: 0.375rem; }
				.prose h3 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; color: oklch(var(--bc)); }
				.prose p { margin-bottom: 1rem; line-height: 1.75; color: oklch(var(--bc)); }
				.prose a { color: oklch(var(--p)); text-decoration: underline; text-underline-offset: 2px; }
				.prose a:hover { color: color-mix(in oklch, oklch(var(--p)) 80%, black); }
				.prose code { background: oklch(var(--b2)); padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875rem; color: oklch(var(--in)); }
				.prose pre { background: oklch(var(--n)); color: oklch(var(--nc)); padding: 1rem; border-radius: 0.5rem; overflow-x: auto; }
				.prose pre code { background: transparent; color: inherit; padding: 0; }
				.prose blockquote { border-left: 4px solid oklch(var(--p)); padding-left: 1rem; color: oklch(var(--bc)); font-style: italic; }
				.prose img { max-width: 100%; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
				.title { font-size: 2.25rem; font-weight: 700; color: oklch(var(--bc)); }
				/* Search */
				#search-results a { display: block; padding: 0.625rem 0.75rem; border-bottom: 1px solid oklch(var(--b3)); color: oklch(var(--bc)); text-decoration: none; transition: background 0.15s; }
				#search-results a:last-child { border-bottom: none; }
				#search-results a:hover { background: oklch(var(--b2)); }
				#search-results .result-title { font-weight: 600; font-size: 0.875rem; }
				#search-results .result-snippet { font-size: 0.75rem; color: oklch(var(--bc) / 0.65); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				#search-results .result-empty { padding: 1rem; text-align: center; color: oklch(var(--bc) / 0.5); font-size: 0.875rem; }
			</style>
		</head>
		<body class="bg-base-200 min-h-screen">
			<header class="sticky top-0 z-10 border-b border-base-300 bg-base-100/80 backdrop-blur-sm">
				<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex items-center justify-between h-16">
						<a href="/" class="text-lg font-bold text-base-content hover:text-primary transition-colors">
							&#127754; {{.SiteName}}
						</a>
						<div class="flex items-center gap-1">
							<nav class="flex gap-1">
								for _, p := range pages {
								if p.URL != "index.html" {
									<a href={ templ.URL(p.URL) } class="px-3 py-1.5 text-sm font-medium text-base-content/70 hover:text-primary hover:bg-base-200 rounded-lg transition-colors">{ p.Title }</a>
								}
							}
							</nav>
							<div class="relative" id="search-container">
						<input type="search" id="search-input" placeholder="Search..." class="w-36 sm:w-48 px-3 py-1.5 text-sm bg-base-200 border border-base-300 rounded-lg text-base-content placeholder:text-base-content/40 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"/>
						<div id="search-results" class="absolute right-0 top-full mt-1 w-72 sm:w-96 bg-base-100 border border-base-300 rounded-lg shadow-xl hidden max-h-80 overflow-y-auto z-50"></div>
					</div>
					<button id="theme-toggle" class="btn btn-ghost btn-sm" onclick="cycleTheme()" aria-label="Switch theme">
								<svg id="theme-icon-system" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
								<svg id="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
								<svg id="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
							</button>
						</div>
					</div>
				</div>
			</header>
			<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
				<article class="prose max-w-none">{ content }</article>
			</main>
			<footer class="border-t border-base-300 bg-base-100/50 mt-12">
				<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-center text-sm text-base-content/60">
					Built with &hearts; using <a href="https://github.com/qjcg/arcadia" class="text-primary hover:text-primary/80 underline">Pavona</a>
				</div>
			</footer>
			<script src="https://cdn.jsdelivr.net/npm/flexsearch@0.8.105/dist/flexsearch.bundle.min.js"></script>
			<script>
				var searchIndex = null;
				var flexIndex = null;
				var searchData = null;

				function initSearch(data) {
					searchData = data;
					flexIndex = new FlexSearch.Document({
						document: { id: 'id', index: ['title', 'content'], store: ['title', 'url'] },
						tokenize: 'forward'
					});
					for (var i = 0; i < data.length; i++) {
						flexIndex.add(data[i]);
					}
				}

				function performSearch(query) {
					var container = document.getElementById('search-results');
					if (!flexIndex || query.length < 2) {
						container.classList.add('hidden');
						return;
					}
					var results = flexIndex.search(query, { limit: 10, enrich: true });
					var hits = [];
					var seen = {};
					for (var f = 0; f < results.length; f++) {
						for (var r = 0; r < results[f].result.length; r++) {
							var item = results[f].result[r];
							if (!seen[item.id]) {
								seen[item.id] = true;
								hits.push(item);
							}
						}
					}
					if (hits.length === 0) {
						container.innerHTML = '<div class="result-empty">No results found</div>';
						container.classList.remove('hidden');
						return;
					}
					var html = '';
					for (var i = 0; i < hits.length; i++) {
						var doc = searchData[hits[i].id];
						var snippet = doc.content.substring(0, 120);
						html += '<a href="/' + doc.url + '"><div class="result-title">' + doc.title + '</div><div class="result-snippet">' + snippet + '</div></a>';
					}
					container.innerHTML = html;
					container.classList.remove('hidden');
				}

				function getTheme() {
					return localStorage.getItem('theme') || 'system';
				}
				function setTheme(theme) {
					localStorage.setItem('theme', theme);
					applyTheme(theme);
				}
				function applyTheme(theme) {
					var html = document.documentElement;
					if (theme === 'system') {
						var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
						html.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
					} else {
						html.setAttribute('data-theme', theme);
					}
					updateToggleIcon(theme);
				}
				function updateToggleIcon(theme) {
					document.getElementById('theme-icon-system').classList.toggle('hidden', theme !== 'system');
					document.getElementById('theme-icon-light').classList.toggle('hidden', theme !== 'light');
					document.getElementById('theme-icon-dark').classList.toggle('hidden', theme !== 'dark');
				}
				function cycleTheme() {
					var themes = ['system', 'light', 'dark'];
					var current = getTheme();
					var next = themes[(themes.indexOf(current) + 1) % themes.length];
					setTheme(next);
				}
				document.addEventListener('DOMContentLoaded', function() {
					applyTheme(getTheme());
					window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
						if (getTheme() === 'system') applyTheme('system');
					});
					fetch('/search-index.json').then(function(r) { return r.json(); }).then(function(data) {
						initSearch(data);
					});
					var searchInput = document.getElementById('search-input');
					var searchResults = document.getElementById('search-results');
					var debounceTimer = null;
					searchInput.addEventListener('input', function() {
						clearTimeout(debounceTimer);
						debounceTimer = setTimeout(function() {
							performSearch(searchInput.value.trim());
						}, 150);
					});
					searchInput.addEventListener('focus', function() {
						if (searchInput.value.trim().length >= 2) searchResults.classList.remove('hidden');
					});
					document.addEventListener('click', function(e) {
						if (!document.getElementById('search-container').contains(e.target)) {
							searchResults.classList.add('hidden');
						}
					});
					searchInput.addEventListener('keydown', function(e) {
						if (e.key === 'Escape') searchResults.classList.add('hidden');
					});
				});
			</script>
		</body>
	</html>
}
