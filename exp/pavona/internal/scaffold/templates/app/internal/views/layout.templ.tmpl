package views

templ Layout(title string, children ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5.6.3/dist/full.min.css" rel="stylesheet" type="text/css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-3bH00D3lEVo0nb9FjwJp7BtVfVWh0yoK7Y/qTOSPh+dQ3GfB4jqHRc+TP6Huo5k" crossorigin="anonymous"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body class="min-h-screen bg-base-200">
			<div class="navbar bg-base-100 shadow-sm mb-6">
				<div class="flex-1">
					<a class="btn btn-ghost text-xl" href="/">{ title }</a>
				</div>
				<div class="flex-none">
					<ul class="menu menu-horizontal px-1">
						<li><a href="/">Home</a></li>
						<li><a href="/health">Health</a></li>
					</ul>
				</div>
			</div>
			<main class="container mx-auto px-4">
				{ children... }
			</main>
		</body>
	</html>
}
