package views

import "{{.Name}}/internal/handlers"

templ Index(links []handlers.Link) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>URL Shortener</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&display=swap" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
			<style>
				body { font-family: 'Inter', sans-serif; }
			</style>
		</head>
		<body class="min-h-screen" x-data="{ expiry: 86400 }">
			<div class="relative min-h-screen">
				<!-- Background gradient -->
				<div class="fixed inset-0 -z-10 bg-gradient-to-br from-base-300 via-base-200 to-base-300"></div>
				<div class="fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,hsl(var(--p)/0.15),transparent_60%)]"></div>
				<div class="fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom_left,hsl(var(--s)/0.1),transparent_60%)]"></div>

				<!-- Navbar -->
				<nav class="navbar bg-base-100/70 backdrop-blur-md border-b border-base-300/50 sticky top-0 z-50">
					<div class="navbar-start">
						<a class="btn btn-ghost text-xl gap-2" href="/">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 text-primary">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
							</svg>
							<span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">snip.url</span>
						</a>
					</div>
					<div class="navbar-end gap-2">
						<a href="/health" class="btn btn-ghost btn-sm">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 1 0-18 0"/><path d="M9 10a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1z"/><path d="M10 9V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4"/></svg>
							Health
						</a>
					</div>
				</nav>

				<!-- Main content -->
				<main class="container mx-auto max-w-4xl px-4 py-8 space-y-8">
					<!-- Hero section -->
					<div class="text-center space-y-3 pb-2">
						<h1 class="text-5xl md:text-6xl font-bold tracking-tight">
							<span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">Shorten</span>
							<span class="text-base-content"> it.</span>
						</h1>
						<p class="text-base-content/60 text-lg max-w-lg mx-auto">
							Paste a long URL and get a short, shareable link — with optional expiry and beautiful QR codes.
						</p>
					</div>

					<!-- Create form card -->
					<div class="card bg-base-100/60 backdrop-blur-sm border border-base-300/50 shadow-xl transition-all duration-300 hover:shadow-2xl hover:border-primary/30">
						<div class="card-body gap-6">
							<h2 class="card-title text-xl">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-primary"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
								Create short link
							</h2>
							<form hx-post="/" hx-target="#links-body" hx-swap="afterbegin" hx-on::after-request="if(event.detail.success) this.reset(); expiry=86400" class="flex flex-col gap-5">
								<label class="input input-bordered flex items-center gap-3 bg-base-200/50 focus-within:bg-base-200 transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-base-content/40 shrink-0"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
									<input type="url" name="url" placeholder="https://example.com/very/long/url" class="grow" required/>
								</label>
								<label class="input input-bordered flex items-center gap-3 bg-base-200/50 focus-within:bg-base-200 transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-base-content/40 shrink-0"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
									<span class="text-base-content/40 shrink-0">/</span>
									<input type="text" name="code" placeholder="custom-slug (optional)" class="grow font-mono text-sm" pattern="[a-zA-Z0-9\-_]{2,32}" title="2–32 characters: letters, digits, dashes, underscores"/>
								</label>
								<div>
									<label class="label py-1">
										<span class="label-text flex items-center gap-1.5">
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-base-content/40"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
											Expires: <span class="font-semibold text-primary" x-text="expiryLabel(expiry)">1 day</span>
										</span>
									</label>
									<input type="range" name="expiry" min="0" max="2592000" step="1" value="86400" class="range range-primary w-full" x-model="expiry"/>
									<div class="flex justify-between text-xs px-1 mt-1.5 text-base-content/40">
										<span>Never</span>
										<span>1h</span>
										<span>1d</span>
										<span>1w</span>
										<span>1mo</span>
									</div>
								</div>
								<button type="submit" class="btn btn-primary btn-block gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
									Shorten!
								</button>
							</form>
						</div>
					</div>

					<!-- Recent links card -->
					<div class="card bg-base-100/60 backdrop-blur-sm border border-base-300/50 shadow-xl">
						<div class="card-body">
							<h2 class="card-title text-xl mb-2">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-secondary"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
								Recent links
							</h2>
							<div class="overflow-x-auto">
								<table class="table table-zebra table-pin-rows">
									<thead>
										<tr class="text-base-content/60 text-xs uppercase tracking-wider">
											<th class="w-16">QR</th>
											<th>Short URL</th>
											<th>Original</th>
											<th class="w-24">Expires</th>
											<th class="w-10"></th>
										</tr>
									</thead>
									<tbody id="links-body">
										for _, l := range links {
											<tr id={"row-" + l.ShortCode} class="hover transition-colors">
												<td>
													if l.QRDataURI != "" {
														<div class="dropdown dropdown-right">
															<img src={ l.QRDataURI } alt="QR" class="w-10 h-10 rounded-box cursor-pointer ring-1 ring-base-300 hover:ring-primary transition-all" title={ l.ShortCode } tabindex="0" role="button"/>
															<div class="dropdown-content z-10 p-2 bg-base-100 rounded-box shadow-2xl border border-base-300/50 mt-1">
																<img src={ l.QRDataURI } alt="QR" class="w-48 h-48 rounded-box"/>
															</div>
														</div>
													} else {
														<a href={ templ.URL("/" + l.ShortCode + "/qr.png") } class="btn btn-xs btn-ghost" target="_blank">QR</a>
													}
												</td>
												<td>
													<a href={ templ.URL("/" + l.ShortCode) } class="font-mono text-sm link link-primary font-semibold" hx-boost="false" target="_blank">
														{ "/" + l.ShortCode }
													</a>
												</td>
												<td class="max-w-xs">
													<a href={ templ.URL(l.OriginalURL) } class="link link-secondary text-sm truncate block" target="_blank">
														{ l.OriginalURL }
													</a>
												</td>
												<td>
													if l.IsExpired {
														<span class="badge badge-error badge-sm gap-1">
															<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
															Expired
														</span>
													} else {
														if l.ExpiresAt != "" {
															<span class="text-xs text-base-content/60">{ l.ExpiresAt }</span>
														} else {
															<span class="text-xs text-base-content/40">—</span>
														}
													}
												</td>
												<td>
													<button class="btn btn-xs btn-ghost btn-square text-base-content/40 hover:text-error transition-colors" hx-delete={ "/" + l.ShortCode } hx-target={ "#row-" + l.ShortCode } hx-swap="outerHTML" title="Delete">
														<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
													</button>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
							if len(links) == 0 {
								<div class="flex flex-col items-center justify-center py-12 text-base-content/30 gap-3">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-12"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
									<p class="text-sm">No links yet. Create your first short link above!</p>
								</div>
							}
						</div>
					</div>

					<!-- Footer -->
					<footer class="text-center text-xs text-base-content/30 pb-8">
						Powered by snip.url
					</footer>
				</main>
			</div>
			<script>
				function expiryLabel(val) {
					var v = parseInt(val);
					if (v === 0) return 'Never';
					if (v < 3600) return '< 1 hour';
					if (v < 86400) return Math.floor(v/3600) + ' hours';
					if (v < 604800) return Math.floor(v/86400) + ' days';
					if (v < 2592000) return Math.floor(v/604800) + ' weeks';
					return Math.floor(v/2592000) + ' months';
				}
			</script>
		</body>
	</html>
}
