package handlers

import (
	"bytes"
	"crypto/rand"
	"database/sql"
	"encoding/base64"
	"fmt"
	"io"
	"log/slog"
	"math/big"
	"net/http"
	"net/url"
	"os"
	"strings"
	"time"

	qrcode "github.com/yeqown/go-qrcode/v2"
	"github.com/yeqown/go-qrcode/writer/standard"
)

// nopCloser wraps an io.Writer to implement io.WriteCloser.
type nopCloser struct {
	io.Writer
}

func (nopCloser) Close() error { return nil }

type ShortenHandler struct {
	db *sql.DB
}

type Link struct {
	ShortCode   string `json:"short_code"`
	OriginalURL string `json:"original_url"`
	ExpiresAt   string `json:"expires_at,omitempty"`
	CreatedAt   string `json:"created_at"`
	IsExpired   bool   `json:"is_expired"`
	QRDataURI   string `json:"qr_data_uri,omitempty"`
	QRBytes     []byte `json:"-"`
}

func NewShortenHandler(db *sql.DB) *ShortenHandler {
	return &ShortenHandler{db: db}
}

func (h *ShortenHandler) ListRecent() ([]Link, error) {
	rows, err := h.db.Query(`SELECT short_code, original_url, COALESCE(expires_at, ''), created_at, qr_code FROM urls ORDER BY created_at DESC LIMIT 20`)
	if err != nil {
		return nil, err
	}
	defer rows.Close()

	var links []Link
	for rows.Next() {
		var l Link
		var expiresAt string
		if err := rows.Scan(&l.ShortCode, &l.OriginalURL, &expiresAt, &l.CreatedAt, &l.QRBytes); err != nil {
			return nil, err
		}
		l.ExpiresAt = expiresAt
		l.IsExpired = isExpired(expiresAt)
		if len(l.QRBytes) > 0 {
			l.QRDataURI = "data:image/png;base64," + base64.StdEncoding.EncodeToString(l.QRBytes)
		}
		links = append(links, l)
	}
	return links, rows.Err()
}

func (h *ShortenHandler) Create(w http.ResponseWriter, r *http.Request) {
	if err := r.ParseForm(); err != nil {
		http.Error(w, "bad request", http.StatusBadRequest)
		return
	}

	originalURL := strings.TrimSpace(r.FormValue("url"))
	if originalURL == "" {
		http.Error(w, "url required", http.StatusBadRequest)
		return
	}

	// Validate URL
	if !strings.HasPrefix(originalURL, "http://") && !strings.HasPrefix(originalURL, "https://") {
		originalURL = "https://" + originalURL
	}
	if _, err := url.Parse(originalURL); err != nil {
		http.Error(w, "invalid url", http.StatusBadRequest)
		return
	}

	// Parse expiry seconds from slider
	expirySeconds := 0
	fmt.Sscanf(r.FormValue("expiry"), "%d", &expirySeconds)

	var expiresAt *time.Time
	if expirySeconds > 0 {
		t := time.Now().Add(time.Duration(expirySeconds) * time.Second)
		expiresAt = &t
	}

	// Generate short code
	shortCode := generateShortCode()

	// Generate QR code PNG bytes
	baseURL := fmt.Sprintf("http://localhost:8080/%s", shortCode)
	qrPNG, err := encodeQR(baseURL)
	if err != nil {
		slog.Error("failed to generate QR code", "error", err)
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}
	qrDataURI := "data:image/png;base64," + base64.StdEncoding.EncodeToString(qrPNG)

	// Insert with QR code bytes
	var expiresStr *string
	if expiresAt != nil {
		s := expiresAt.Format(time.RFC3339)
		expiresStr = &s
	}
	_, err = h.db.Exec(`INSERT INTO urls (short_code, original_url, expires_at, qr_code) VALUES (?, ?, ?, ?)`,
		shortCode, originalURL, expiresStr, qrPNG)
	if err != nil {
		slog.Error("failed to insert url", "error", err)
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}

	// Return the table row HTML fragment
	expiryLabel := "Never"
	if expiresAt != nil {
		expiryLabel = formatDuration(time.Until(*expiresAt))
	}
	fmt.Fprintf(w, `<tr class="hover" id="row-%s">
		<td><img src="%s" alt="QR" class="w-10 h-10" title="%s"/></td>
		<td><a href="/%s" class="link link-primary" hx-boost="false">/%s</a></td>
		<td class="max-w-xs truncate"><a href="%s" class="link link-secondary" target="_blank">%s</a></td>
		<td>%s</td>
		<td><button class="btn btn-xs btn-ghost" hx-delete="/%s" hx-target="#row-%s" hx-swap="outerHTML">✕</button></td>
	</tr>`, shortCode, qrDataURI, shortCode, shortCode, shortCode, originalURL, originalURL, expiryLabel, shortCode, shortCode)
}

func (h *ShortenHandler) Redirect(w http.ResponseWriter, r *http.Request) {
	code := r.PathValue("code")
	if code == "" {
		http.NotFound(w, r)
		return
	}

	var originalURL string
	var expiresAt sql.NullString
	err := h.db.QueryRow(`SELECT original_url, expires_at FROM urls WHERE short_code = ?`, code).Scan(&originalURL, &expiresAt)
	if err == sql.ErrNoRows {
		http.NotFound(w, r)
		return
	}
	if err != nil {
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}

	if expiresAt.Valid && isExpired(expiresAt.String) {
		w.WriteHeader(http.StatusGone)
		w.Write([]byte(fmt.Sprintf(`<!DOCTYPE html><html lang="en" data-theme="dark"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Link Expired</title><link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/><link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css"/><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script></head><body class="min-h-screen flex items-center justify-center"><div class="fixed inset-0 -z-10 bg-gradient-to-br from-base-300 via-base-200 to-base-300"></div><div class="fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,hsl(var(--er)/0.08),transparent_60%%)]"></div><div class="text-center max-w-md px-4"><div class="text-8xl font-bold bg-gradient-to-b from-error to-error/50 bg-clip-text text-transparent mb-4">410</div><h1 class="text-3xl font-semibold mb-2">This link has expired</h1><p class="text-base-content/60 mb-2">The short link <code class="font-mono bg-base-300 px-2 py-0.5 rounded">/%s</code> is no longer available.</p><p class="text-sm text-base-content/40 mb-6">Links expire based on the time chosen when they were created.</p><a href="/" class="btn btn-primary">Create a new short link</a></div></body></html>`, code)))
		return
	}

	http.Redirect(w, r, originalURL, http.StatusMovedPermanently)
}

func (h *ShortenHandler) QRCode(w http.ResponseWriter, r *http.Request) {
	code := r.PathValue("code")
	if code == "" {
		http.NotFound(w, r)
		return
	}

	var qrBytes []byte
	err := h.db.QueryRow(`SELECT qr_code FROM urls WHERE short_code = ?`, code).Scan(&qrBytes)
	if err == sql.ErrNoRows {
		http.NotFound(w, r)
		return
	}
	if err != nil {
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}

	// Fallback: regenerate if QR not stored (legacy rows)
	if len(qrBytes) == 0 {
		baseURL := fmt.Sprintf("http://localhost:8080/%s", code)
		qrBytes, err = encodeQR(baseURL)
		if err != nil {
			http.Error(w, "internal error", http.StatusInternalServerError)
			return
		}
		// Store for next time
		h.db.Exec(`UPDATE urls SET qr_code = ? WHERE short_code = ?`, qrBytes, code)
	}

	w.Header().Set("Content-Type", "image/png")
	w.Header().Set("Cache-Control", "public, max-age=86400")
	w.Write(qrBytes)
}

func (h *ShortenHandler) Delete(w http.ResponseWriter, r *http.Request) {
	code := r.PathValue("code")
	if code == "" {
		http.NotFound(w, r)
		return
	}

	_, err := h.db.Exec(`DELETE FROM urls WHERE short_code = ?`, code)
	if err != nil {
		slog.Error("failed to delete url", "error", err)
		http.Error(w, "internal error", http.StatusInternalServerError)
		return
	}

	w.WriteHeader(http.StatusOK)
}

// encodeQR generates a QR code PNG for the given text.
func encodeQR(text string) ([]byte, error) {
	qrc, err := qrcode.NewWith(text, qrcode.WithErrorCorrectionLevel(qrcode.ErrorCorrectionMedium))
	if err != nil {
		return nil, fmt.Errorf("creating qr code: %w", err)
	}
	buf := &bytes.Buffer{}
	w := standard.NewWithWriter(&nopCloser{buf},
		standard.WithBuiltinImageEncoder(standard.PNG_FORMAT),
	)
	if err := qrc.Save(w); err != nil {
		return nil, fmt.Errorf("saving qr code: %w", err)
	}
	return buf.Bytes(), nil
}

func generateShortCode() string {
	const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
	code := make([]byte, 6)
	for i := range code {
		n, _ := rand.Int(rand.Reader, big.NewInt(int64(len(charset))))
		code[i] = charset[n.Int64()]
	}
	return string(code)
}

func isExpired(expiresAt string) bool {
	if expiresAt == "" {
		return false
	}
	t, err := time.Parse(time.RFC3339, expiresAt)
	if err != nil {
		return false
	}
	return time.Now().After(t)
}

func formatDuration(d time.Duration) string {
	if d < 0 {
		return "Expired"
	}
	hours := int(d.Hours())
	if hours < 1 {
		return "< 1 hour"
	}
	if hours < 24 {
		return fmt.Sprintf("%d hours", hours)
	}
	days := hours / 24
	if days < 30 {
		return fmt.Sprintf("%d days", days)
	}
	months := days / 30
	return fmt.Sprintf("%d months", months)
}

func init() {
	// Ensure log output goes to stderr
	slog.SetDefault(slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo})))
}
