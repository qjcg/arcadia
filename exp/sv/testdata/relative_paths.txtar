# Setup git repo
exec git init
exec git config user.email test@example.com
exec git config user.name "Test User"

mkdir exp
mkdir exp/sv
mkdir exp/slidesdeck

cp go_mod_sv exp/sv/go.mod
cp go_mod_sd exp/slidesdeck/go.mod

exec git add .
exec git commit -m initial
exec git tag exp/slidesdeck/v1.0.0

# Add a feature
cp feat_txt exp/slidesdeck/feat.txt
exec git add exp/slidesdeck/feat.txt
exec git commit -m feat:relpath

# Run from exp/sv pointing to ../slidesdeck
cd exp/sv
exec sv next --path ../slidesdeck
stdout '^exp/slidesdeck/v1.1.0'

-- go_mod_sv --
module github.com/qjcg/arcadia/exp/sv
-- go_mod_sd --
module github.com/qjcg/arcadia/exp/slidesdeck
-- feat_txt --
feature
