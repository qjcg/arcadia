package templates

import (
	"fmt"
	"strconv"
	"temenos/internal/domain"
	"temenos/internal/storage"
)

func intStr(n int) string {
	return strconv.Itoa(n)
}

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		<script src="https://cdn.tailwindcss.com"></script>
		<link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css" rel="stylesheet" type="text/css"/>
	</head>
	<body>
		{ children... }
	</body>
	</html>
}

templ Navbar() {
	<div class="navbar bg-base-100 shadow-lg">
		<div class="flex-1">
			<a href="/" class="btn btn-ghost text-xl">Temenos</a>
		</div>
		<div class="flex-none">
			<a href="/" class="btn btn-ghost">Home</a>
			<a href="/modules" class="btn btn-ghost">Modules</a>
			<a href="/progress" class="btn btn-ghost">Progress</a>
		</div>
	</div>
}

templ Home() {
	@Base("Temenos") {
		<div class="min-h-screen bg-base-200 flex items-center justify-center">
			<div class="card bg-base-100 shadow-xl">
				<div class="card-body">
					<h2 class="card-title text-2xl font-bold">Temenos</h2>
					<p class="text-base-content/70">A personal learning tool</p>
				</div>
			</div>
		</div>
	}
}

templ Modules(modules []domain.Module) {
	@Base("Modules - Temenos") {
		<div class="min-h-screen bg-base-200">
			@Navbar()
			<div class="container mx-auto p-4">
				<h1 class="text-3xl font-bold mb-6">Learning Modules</h1>
				if len(modules) == 0 {
					<div class="alert alert-info">
						<span>No modules yet. Create your first module to get started!</span>
					</div>
				} else {
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
						for _, m := range modules {
							<a href={ templ.SafeURL("/modules/" + m.ID) } class="card bg-base-100 hover:bg-base-300 transition-colors cursor-pointer">
								<div class="card-body">
									<h2 class="card-title">{ m.Title }</h2>
									<p class="text-base-content/70">{ m.Description }</p>
								</div>
							</a>
						}
					</div>
				}
			</div>
		</div>
	}
}

templ ModuleDetail(mod domain.Module, cards []domain.Card, moduleID string) {
	@Base(mod.Title + " - Temenos") {
		<div class="min-h-screen bg-base-200">
			@Navbar()
			<div class="container mx-auto p-4">
				<h1 class="text-3xl font-bold mb-2">{ mod.Title }</h1>
				<p class="text-base-content/70 mb-4">{ mod.Description }</p>
				<a href={ templ.SafeURL("/study/" + moduleID) } class="btn btn-primary mb-6">Study Now</a>
				<div class="stats shadow mb-6">
					<div class="stat">
						<div class="stat-title">Cards</div>
						<div class="stat-value">{ intStr(len(cards)) }</div>
					</div>
				</div>
				<h2 class="text-xl font-bold mb-4">Cards</h2>
				if len(cards) == 0 {
					<div class="alert alert-info">
						<span>No cards in this module yet.</span>
					</div>
				} else {
					<div class="grid grid-cols-1 gap-4">
						for _, c := range cards {
							<div class="card bg-base-100">
								<div class="card-body">
									<h3 class="card-title text-lg">{ c.Front }</h3>
									<p class="text-base-content/80">{ c.Back }</p>
								</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}

templ StudyCard(modID string, card domain.Card, currentIdx, totalCards, nextIdx int) {
	@Base("Study - Temenos") {
		<div class="min-h-screen bg-base-200" id="study-container" data-module-id={ modID } data-card-id={ card.ID } data-next-idx={ intStr(nextIdx) }>
			@Navbar()
			<div class="container mx-auto p-4 flex flex-col items-center justify-center min-h-[80vh]">
				<div class="text-sm text-base-content/60 mb-4">Card { intStr(currentIdx + 1) } of { intStr(totalCards) }</div>

				<!-- Flashcard with 3D flip animation -->
				<div class="card-container w-full max-w-lg h-80 perspective-1000" onclick="flipCard()">
					<div id="flashcard" class="card-inner relative w-full h-full transition-transform duration-500 transform-style-3d cursor-pointer">
						<!-- Front -->
						<div class="card-front absolute inset-0 backface-hidden flex items-center justify-center bg-base-100 rounded-box shadow-xl p-8">
							<div class="text-2xl font-bold text-center">{ card.Front }</div>
						</div>
						<!-- Back -->
						<div class="card-back absolute inset-0 backface-hidden flex items-center justify-center bg-base-100 rounded-box shadow-xl p-8 rotate-y-180">
							<div class="text-xl text-center">{ card.Back }</div>
						</div>
					</div>
				</div>

				<div id="rating" class="hidden mt-8">
					<p class="text-center mb-4">How well did you know this?</p>
					<div class="flex gap-2 justify-center">
						<button onclick="rateCard(0)" class="btn btn-error">Again</button>
						<button onclick="rateCard(2)" class="btn btn-warning">Hard</button>
						<button onclick="rateCard(3)" class="btn btn-info">Good</button>
						<button onclick="rateCard(5)" class="btn btn-success">Easy</button>
					</div>
				</div>
			</div>
		</div>
		<script>
			let isFlipped = false;
			function flipCard() {
				const card = document.getElementById('flashcard');
				const rating = document.getElementById('rating');
				if (!isFlipped) {
					card.classList.add('rotate-y-180');
					rating.classList.remove('hidden');
				}
				isFlipped = !isFlipped;
			}
			function rateCard(quality) {
				const container = document.getElementById('study-container');
				const cardId = container.dataset.cardId;
				const modId = container.dataset.moduleId;
				const nextIdx = container.dataset.nextIdx;

				var formData = new FormData();
				formData.append('card_id', cardId);
				formData.append('quality', quality);
				fetch('/api/review', {
					method: 'POST',
					body: formData
				}).then(() => {
					window.location.href = '/study/' + modId + '?idx=' + nextIdx;
				});
			}
		</script>
		<style>
			.perspective-1000 { perspective: 1000px; }
			.transform-style-3d { transform-style: preserve-3d; }
			.backface-hidden { backface-visibility: hidden; }
			.rotate-y-180 { transform: rotateY(180deg); }
		</style>
	}
}

templ StudyComplete(modID, modTitle string) {
	@Base("Study Complete - Temenos") {
		<div class="min-h-screen bg-base-200 flex items-center justify-center">
			<div class="card bg-base-100 shadow-xl">
				<div class="card-body text-center">
					<h2 class="card-title text-2xl font-bold justify-center">All caught up!</h2>
					<p class="text-base-content/70">No more cards to review in { modTitle } right now.</p>
					<div class="card-actions justify-end mt-4">
						<a href={ templ.SafeURL("/modules/" + modID) } class="btn btn-primary">Back to Module</a>
					</div>
				</div>
			</div>
		</div>
	}
}

templ Progress(totalReviews, cardsDue, streak int, modules []domain.Module, allStats map[string]*storage.ModuleStats) {
	@Base("Progress - Temenos") {
		<div class="min-h-screen bg-base-200">
			@Navbar()
			<div class="container mx-auto p-4">
				<h1 class="text-3xl font-bold mb-6">Your Progress</h1>

				<div class="stats stats-vertical lg:stats-horizontal shadow mb-6">
					<div class="stat">
						<div class="stat-title">Total Reviews</div>
						<div class="stat-value">{ intStr(totalReviews) }</div>
					</div>
					<div class="stat">
						<div class="stat-title">Cards Due</div>
						<div class="stat-value">{ intStr(cardsDue) }</div>
					</div>
					<div class="stat">
						<div class="stat-title">Current Streak</div>
						<div class="stat-value">{ intStr(streak) }</div>
						<div class="stat-desc">days</div>
					</div>
					<div class="stat">
						<div class="stat-title">Modules</div>
						<div class="stat-value">{ intStr(len(modules)) }</div>
					</div>
				</div>

				<h2 class="text-xl font-bold mb-4">Module Progress</h2>
				if len(modules) == 0 {
					<div class="alert alert-info">
						<span>No modules yet.</span>
					</div>
				} else {
					<div class="grid grid-cols-1 gap-4">
						for _, m := range modules {
							@ModuleProgressCard(m, allStats[m.ID])
						}
					</div>
				}
			</div>
		</div>
	}
}

templ ModuleProgressCard(m domain.Module, stats *storage.ModuleStats) {
	<div class="card bg-base-100">
		<div class="card-body">
			<h3 class="card-title">{ m.Title }</h3>
			<p class="text-base-content/70 mb-2">{ m.Description }</p>
			@ProgressBar(stats)
			<div class="flex justify-between text-sm text-base-content/60">
				<span>{ intStr(stats.ReviewedCards) } / { intStr(stats.TotalCards) } cards reviewed</span>
				<span>Avg quality: { fmt.Sprintf("%.1f", stats.AvgQuality) }</span>
			</div>
		</div>
	</div>
}

templ ProgressBar(stats *storage.ModuleStats) {
	<progress class="progress progress-primary w-full" value={ intStr(getProgress(stats)) } max="100"></progress>
}

func getProgress(stats *storage.ModuleStats) int {
	if stats == nil || stats.TotalCards == 0 {
		return 0
	}
	return (stats.ReviewedCards * 100) / stats.TotalCards
}
