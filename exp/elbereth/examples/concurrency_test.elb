; Concurrency examples
; Now fully implemented in v0.2+

(defn worker [id ch (chan string)]
  (println "Worker" id "started")
  (>! ch (str "Hello from worker " id)))

(deftest concurrency-test
  (let [ch (chan string 2)]
    (go (worker 1 ch))
    (go (worker 2 ch))
    (println (<! ch))
    (println (<! ch))))
