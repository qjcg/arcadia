; Conditional expressions

(deftest conditionals-test
  (println "Testing conditionals:")
  (if (> 5 3)
    (println "5 is greater than 3")
    (println "5 is not greater than 3"))
  (if (== 2 2)
    (println "2 equals 2")
    (println "2 does not equal 2"))
  (if (< 1 10)
    (println "1 is less than 10")
    (println "1 is not less than 10")))
