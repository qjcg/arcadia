-- data.cue --
name: "test"
value: 42

# cue eval
terebra -c 'cue eval data.cue'
stdout 'name:'
stdout 'value: 42'

# cue export
terebra -c 'cue export data.cue'
stdout '{"name":"test","value":42}'

# cue def
terebra -c 'cue def data.cue'
stdout 'name: "test"'
stdout 'value: 42'

# cue vet with schema
-- schema.cue --
name: string
value: int

# cue vet valid
terebra -c 'cue vet data.cue schema.cue'
stdout 'ok'

# cue vet invalid
-- bad.cue --
name: 123
terebra -c 'cue vet bad.cue schema.cue'
! stdout 'ok'

# cue no subcommand
! terebra -c 'cue'
stderr 'cue: expected subcommand'

# cue unknown subcommand
! terebra -c 'cue bogus'
stderr 'unknown subcommand'