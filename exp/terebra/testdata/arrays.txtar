# indexed array — all values
terebra -c 'arr=(a b c) ; echo ${arr[@]}'
stdout 'a b c'

# indexed array — length
terebra -c 'arr=(a b c) ; echo ${#arr[@]}'
stdout '3'

# indexed array — element assignment
terebra -c 'arr=(a b c) ; arr[1]=x ; echo ${arr[1]}'
stdout 'x'

# associative array — all values
terebra -c 'declare -A colors ; colors[red]=r ; colors[blue]=b ; echo ${colors[@]}'
stdout 'r'
stdout 'b'

# non-numeric subscript without declare -A is bash arithmetic indexing
terebra -c 'arr[key]=val ; echo ${arr[key]}'
stdout 'val'

# indexed array access without braces
terebra -c 'arr=(a b c) ; echo $arr[0]'
stdout 'a'

# associative array access without braces
terebra -c 'declare -A colors ; colors[red]=r ; echo $colors[red]'
stdout 'r'