-- hello.txt --
hello
-- world.txt --
world
-- sub/nested.txt --
nested
-- sub/deep/deep.txt --
deep

# glob match
terebra echo *.txt
stdout 'hello.txt'
stdout 'world.txt'

# no match — passes literal
terebra echo *.nonexistent
stdout '*.nonexistent'

# recursive glob — all .txt files
terebra echo **/*.txt
stdout 'hello.txt'
stdout 'world.txt'
stdout 'sub/nested.txt'
stdout 'sub/deep/deep.txt'

# recursive glob — ** at start
terebra echo **/deep.txt
stdout 'sub/deep/deep.txt'

# recursive glob — ** at end
terebra echo sub/**
stdout 'sub/nested.txt'
stdout 'sub/deep/deep.txt'

# glob with ? matching single char
-- ab.txt --
ab
-- ac.txt --
ac
terebra echo ??.txt
stdout 'ab.txt'
stdout 'ac.txt'

# glob with [...] character class
terebra echo [a-z]*.txt
stdout 'ab.txt'
stdout 'ac.txt'