# substring
terebra -c 'FOO=hello ; echo ${FOO:0:2}'
stdout 'he'

# replace first
terebra -c 'FOO=hello ; echo ${FOO/l/xyz}'
stdout 'hexyzlo'

# replace all
terebra -c 'FOO=hello ; echo ${FOO//l/xyz}'
stdout 'hexyzxyzo'

# uppercase first
terebra -c 'FOO=hello ; echo ${FOO^}'
stdout 'Hello'

# uppercase all
terebra -c 'FOO=hello ; echo ${FOO^^}'
stdout 'HELLO'

# length
terebra -c 'FOO=hello ; echo ${#FOO}'
stdout '5'

# remove shortest prefix
terebra -c 'FOO=hello ; echo ${FOO#hel}'
stdout 'lo'

# remove longest prefix
terebra -c 'FOO=hello ; echo ${FOO##he}'
stdout 'llo'

# remove shortest suffix
terebra -c 'FOO=hello ; echo ${FOO%lo}'
stdout 'hel'

# remove longest suffix
terebra -c 'FOO=hello ; echo ${FOO%%lo}'
stdout 'hel'

# lowercase first
terebra -c 'FOO=HELLO ; echo ${FOO,}'
stdout 'hELLO'

# lowercase all
terebra -c 'FOO=HELLO ; echo ${FOO,,}'
stdout 'hello'