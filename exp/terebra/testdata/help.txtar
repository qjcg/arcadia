# help lists the shell's builtins, bash style
terebra -c 'help'
stdout 'defined internally'

# help for a specific builtin
terebra -c 'help cd'
stdout 'Change the shell working directory'

# help for an unknown topic reports no match
! terebra -c 'help nonexistent_cmd'
stderr 'no help topics match'

# --version
terebra --version
stdout 'terebra'

# --explain
terebra --explain echo hello
stdout '# would execute: echo hello'
