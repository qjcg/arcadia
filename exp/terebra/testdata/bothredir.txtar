# &> redirects both stdout and stderr to a file
terebra -c 'echo hello &> out.txt ; cat out.txt'
stdout 'hello'

# &>> appends both stdout and stderr to a file
terebra -c 'echo a &> out.txt ; echo b &>> out.txt ; cat out.txt'
stdout 'a'
stdout 'b'

# |& pipes both stdout and stderr
terebra -c 'echo hello |& cat'
stdout 'hello'