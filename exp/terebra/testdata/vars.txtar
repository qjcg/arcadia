# variable expansion
terebra -c 'echo $HOME'
stdout '/no-home'

# local variable assignment
terebra -c 'FOO=bar ; echo $FOO'
stdout 'bar'

# PS1 is a plain variable in scripts; the REPL sets its own default
terebra -c 'PS1="x> " ; echo "$PS1"'
stdout 'x> '

# $$ PID
terebra -c 'echo $$'
stdout '[0-9]+'

# $? exit code
terebra -c 'false ; echo $?'
stdout '1'

# ${VAR} braces
terebra -c 'FOO=bar ; echo ${FOO}'
stdout 'bar'

# undefined variable
terebra -c 'echo $UNDEFINED_VAR_XYZ'
stdout ''

# temporary env var: word expansion runs first, like bash
terebra -c 'FOO=bar echo $FOO'
stdout '^$'

# temporary env var reaches the command's environment
terebra -c 'FOO=bar env'
stdout 'FOO=bar'

# temporary env var does not persist
terebra -c 'FOO=bar env ; echo $FOO'
stdout '^$'
stdout ''

# multiple temporary env vars reach the command's environment
terebra -c 'FOO=bar BAZ=qux env'
stdout 'FOO=bar'
stdout 'BAZ=qux'

# temporary env var alone (no command) sets persistently
terebra -c 'FOO=bar ; echo $FOO'
stdout 'bar'