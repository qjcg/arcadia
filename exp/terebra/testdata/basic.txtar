# basic execution
terebra -c 'echo hello'
stdout 'hello'

# brace expansion
terebra -c 'echo {a,b,c}'
stdout 'a b c'

# numeric range
terebra -c 'echo {1..5}'
stdout '1 2 3 4 5'

# arithmetic
terebra -c 'echo $((2 + 3))'
stdout '5'

# arrays
terebra -c 'arr=(a b c) ; echo ${arr[1]}'
stdout 'b'

# associative array
terebra -c 'colors[red]="#ff0000" ; echo ${colors[red]}'
stdout '#ff0000'

# assoc key listing
terebra -c 'colors[red]=r ; colors[blue]=b ; echo ${!colors[@]}'
stdout 'blue red'

# exit code
! terebra -c 'exit 1'

# arithmetic with variables
terebra -c 'X=5 ; Y=3 ; echo $((X + Y))'
stdout '8'

# exit without argument (exits 0)
terebra -c 'exit 0 ; echo nope'
! stdout 'nope'
