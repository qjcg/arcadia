# type
terebra -c 'type echo'
stdout 'echo is a shell builtin'

# type external
terebra -c 'type ls'
stdout 'ls is '

# command -v locates builtins and files, bash style
terebra -c 'command -v echo'
stdout '^echo$'

# export
terebra -c 'export FOO=bar ; echo $FOO'
stdout 'bar'

# unset
terebra -c 'FOO=bar ; unset FOO ; echo $FOO'
stdout ''

# readonly
terebra -c 'readonly FOO=bar'
stdout ''

# alias
terebra -c 'alias ll="ls -la" ; alias'
stdout 'alias ll=.*ls -la'

# unalias
terebra -c 'alias ll="ls -la" ; unalias ll ; alias'
! stdout 'll'

# set -x debug trace
terebra -c 'set -x ; echo hello'
stderr '\+ echo hello'

# set +x disable debug
terebra -c 'set -x ; set +x ; echo hello'
! stderr 'echo hello'

# readonly enforcement (cannot modify readonly var)
terebra -c 'readonly FOO=bar ; FOO=baz ; echo $FOO'
stdout 'bar'

# type for nonexistent command
! terebra -c 'type nonexistent_cmd_xyz'
stderr 'not found'

# command -v fails quietly for a missing command
! terebra -c 'command -v nonexistent_cmd_xyz'
! stdout '.'

# export reaches the environment
terebra -c 'export FOO=bar ; env'
stdout 'FOO=bar'

# variable listing via declare, bash style
terebra -c 'FOO=bar ; declare -p FOO'
stdout 'FOO="bar"'