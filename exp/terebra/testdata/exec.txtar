# exec with no command is a no-op, like bash
terebra -c 'exec'
! stderr '.'

# exec runs its arguments as a command
terebra -c 'exec echo hello'
stdout 'hello'

# exec with a missing command reports not found
! terebra -c 'exec nonexistent_cmd_xyz'
stderr 'not found'

# the engine's exec takes no options: arguments are the command
! terebra -c 'exec -a'
stderr 'not found'

# type shows exec as builtin
terebra -c 'type exec'
stdout 'exec is a shell builtin'
